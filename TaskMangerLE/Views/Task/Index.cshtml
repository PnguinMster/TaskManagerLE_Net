@model TaskMangerLE.Models.TaskListViewModel

@{
    ViewData["Title"] = "Tasks";

    var createTaskModel =
        ViewData["CreateTaskModel"] as TaskItemCreateViewModel
        ?? new TaskItemCreateViewModel();
}

<header class="page-header">
    <div>
        <h1>Tasks</h1>
        <p class="muted">
            @($"{Model.TotalTaskCount} tasks across {Model.ProjectCount} projects")
        </p>
    </div>

    <button type="button"
            class="btn btn-primary"
            onclick="document.getElementById('create-task-modal').showModal()">
        + New Task
    </button>
</header>

<div class="stack">
    <div class="row wrap">
        <div class="pills" aria-label="Filter tasks by status">
            <button type="button" class="is-active" data-status-filter="all">
                All (@Model.Tasks.Count)
            </button>
            <button type="button" data-status-filter="pending">
                Pending (@Model.Tasks.Count(t => t.Status != TaskMangerLE.Models.Enums.TaskStatus.Done))
            </button>
            <button type="button" data-status-filter="completed">
                Completed (@Model.Tasks.Count(t => t.Status == TaskMangerLE.Models.Enums.TaskStatus.Done))
            </button>
        </div>

        <div class="sp"></div>
        <input class="input input-inline"
               type="search"
               placeholder="Search tasks…"
               aria-label="Search tasks"
               data-task-search/>
    </div>

    <div class="row wrap">
        <select class="input input-inline" aria-label="Project" data-project-filter>
            <option value="">All projects</option>
            @foreach (var project in Model.Tasks
                              .Select(t => t.ProjectName)
                              .Distinct()
                              .OrderBy(name => name)) {
                <option value="@project">@project</option>
            }
        </select>

        <select class="input input-inline" aria-label="Priority" data-priority-filter>
            <option value="">Any priority</option>
            @foreach (var priority in Model.Tasks.Select(t => t.Priority).Distinct().OrderBy(p => p)) {
                <option value="@priority">@priority</option>
            }
        </select>

        <select class="input input-inline" aria-label="Due date" data-due-filter>
            <option value="">Any due date</option>
            <option value="overdue">Overdue</option>
            <option value="today">Today</option>
            <option value="week">This week</option>
            <option value="later">Later</option>
        </select>

        <select class="input input-inline" aria-label="Group by" data-group-by>
            <option value="due">Group by: Due date</option>
            <option value="project">Group by: Project</option>
            <option value="priority">Group by: Priority</option>
            <option value="none">No grouping</option>
        </select>

        <div class="sp"></div>
        <button type="button" class="btn-text" style="color:var(--bt)" data-clear-filters>
            Clear filters
        </button>
    </div>
</div>


@{
    var today = TimeProvider.Today();
    var weekEnd = today.AddDays(7);

    var groups = new[]
    {
        new
        {
            Title = "Overdue",
            Tasks = Model.Tasks
                .Where(t => t.Status != TaskMangerLE.Models.Enums.TaskStatus.Done && t.DueDate < today)
                .ToList(),
            Color = "var(--rt)"
        },
        new
        {
            Title = "Today",
            Tasks = Model.Tasks
                .Where(t => t.Status != TaskMangerLE.Models.Enums.TaskStatus.Done && t.DueDate == today)
                .ToList(),
            Color = "var(--at)"
        },
        new
        {
            Title = "This week",
            Tasks = Model.Tasks
                .Where(t => t.Status != TaskMangerLE.Models.Enums.TaskStatus.Done && t.DueDate > today && t.DueDate <= weekEnd)
                .ToList(),
            Color = "var(--text)"
        },
        new
        {
            Title = "Later",
            Tasks = Model.Tasks
                .Where(t => t.Status != TaskMangerLE.Models.Enums.TaskStatus.Done && t.DueDate > weekEnd)
                .ToList(),
            Color = "var(--text)"
        },
        new
        {
            Title = "Completed",
            Tasks = Model.Tasks
                .Where(t => t.Status == TaskMangerLE.Models.Enums.TaskStatus.Done)
                .ToList(),
            Color = "var(--gt)"
        }
    };

    string PriorityColor(TaskMangerLE.Models.Enums.TaskPriority priority) =>
        priority.ToString() switch
        {
            "High" or "Critical" => "var(--rt)",
            "Medium" => "var(--at)",
            _ => "var(--bt)"
        };

    string DueDateLabel(DateOnly dueDate, bool isDone) =>
        isDone
            ? $"Done {dueDate.ToString("MMM d")}"
            : dueDate == today
                ? "Today"
                : dueDate.ToString("MMM d");
}

@if (Model.Tasks.Count == 0) {
    <div class="card card-dashed empty-state">
        <div
            style="width:64px;height:64px;border-radius:18px;display:grid;place-items:center;color:var(--bt);background:color-mix(in srgb,var(--bt) 14%,transparent)">
            <svg width="28" height="28" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
        </div>

        <h2 style="font-size:20px;font-weight:700">
            No tasks match your filters
        </h2>

        <p class="muted">
            Try removing a filter or searching for something else.
        </p>

        <div class="row wrap" style="justify-content:center;margin-top:6px">
            <button type="button" class="btn btn-lg" data-clear-filters>
                Clear filters
            </button>
        </div>
    </div>
}
else {
    <div class="data-scroll">
        <div class="card" style="padding:0">
            <div class="data-table cols-tasks">
                <div class="data-row data-head">
                    <span></span>
                    <span>Task</span>
                    <span>Project</span>
                    <span>Priority</span>
                    <span>Due</span>
                    <span></span>
                </div>

                @foreach (var group in groups) {
                    if (group.Tasks.Count == 0) {
                        continue;
                    }

                    <div class="group-header">
                        <span style="color:@group.Color">@group.Title</span>
                        <span class="badge badge-muted">@group.Tasks.Count</span>
                    </div>

                    @foreach (var task in group.Tasks) {
                        var isDone = task.Status == TaskMangerLE.Models.Enums.TaskStatus.Done;
                        var priorityColor = PriorityColor(task.Priority);

                        <div class="data-row">
                            <form asp-action="ToggleCompletion"
                                  asp-route-taskId="@task.Id"
                                  method="post"
                                  class="dashboard-complete-form">
                                @Html.AntiForgeryToken()
                                <input type="checkbox"
                                       class="checkbox"
                                       checked="@isDone"
                                       aria-label="@(isDone ? $"Mark {task.Name} as to do" : $"Complete {task.Name}")"
                                       onchange="this.form.submit()"/>
                            </form>

                            <div style="min-width:0">
                                <div class="@(isDone ? "is-done" : "")" style="font-weight:600">
                                    @task.Name
                                </div>
                                @if (!string.IsNullOrWhiteSpace(task.Description)) {
                                    <div class="muted small"
                                         style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        @task.Description
                                    </div>
                                }
                            </div>

                            <a asp-controller="Project"
                               asp-action="Detail"
                               asp-route-projectId="@task.ProjectId"
                               style="color:var(--bt);text-decoration:none;font-weight:500">
                                @task.ProjectName
                            </a>

                            @{
                                var priorityClass = task.Priority.ToString() switch
                                {
                                    "Low" => "badge-blue",
                                    "Medium" => "badge-amber",
                                    "High" or "Critical" => "badge-rose",
                                    _ => "badge-muted"
                                };
                            }

                            <span class="badge @priorityClass">@task.Priority</span>

                            <span
                                style="display:flex;align-items:center;gap:6px;font-size:13px;color:@(group.Title == "Overdue" ? "var(--rt)" : "var(--muted)")">
                            @DueDateLabel(task.DueDate, isDone)
                        </span>

                            <details class="task-card-menu task-row-menu">
                                <summary aria-label="Task actions for @task.Name">
                                    <svg width="18" height="18" viewBox="0 0 24 24"
                                         fill="currentColor" aria-hidden="true">
                                        <circle cx="5" cy="12" r="1.5"></circle>
                                        <circle cx="12" cy="12" r="1.5"></circle>
                                        <circle cx="19" cy="12" r="1.5"></circle>
                                    </svg>
                                </summary>

                                <div class="task-card-menu-panel">
                                    <a asp-controller="Task"
                                       asp-action="Update"
                                       asp-route-taskId="@task.Id">
                                        Edit
                                    </a>

                                    <form asp-controller="Task"
                                          asp-action="Delete"
                                          asp-route-taskId="@task.Id"
                                          method="post"
                                          data-confirm-task-trash="@task.Name"
                                          data-trash-detail="in @task.ProjectName">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Delete</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
<partial name="_CreateTaskModal" model="createTaskModel"/>