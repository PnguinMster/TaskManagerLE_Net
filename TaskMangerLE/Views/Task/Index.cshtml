@model TaskMangerLE.Models.TaskListViewModel

@{
    ViewData["Title"] = "Tasks";

    var createTaskModel =
        ViewData["CreateTaskModel"] as TaskItemCreateViewModel
        ?? new TaskItemCreateViewModel();

    // Every status, for the Status checkboxes in the Filters panel. The enum's numbers are already in
    // workflow order, so GetValues gives the same order as the board columns on Project/Detail. Labels come
    // from [Display]. The checkbox values (see StatusKey) are what each row's data-task-item holds, so
    // site.js can compare them directly.
    TaskStatus[] statuses = Enum.GetValues<TaskStatus>();

    // "ToDo" -> "todo". The same rule the Projects page uses for data-project-item.
    string StatusKey(TaskStatus status) => status.ToString().ToLowerInvariant();

    var today = TimeProvider.Today();
    var weekEnd = today.AddDays(7);

    // "Open" = not finished (see TaskStatusExtensions.IsFinished). Only these go into the due-date groups
    // (a done or cancelled task can't be "overdue"), and they are what the page shows by default.
    bool IsOpen(TaskStatus status) => !status.IsFinished();
    var openTasks = Model.Tasks.Where(t => IsOpen(t.Status)).ToList();
    var openStatusKeys = string.Join(",", statuses.Where(IsOpen).Select(StatusKey));

    // Quick views are presets for the Filters panel: clicking one ticks these statuses, picks this
    // due range and clears Priority and Project. site.js highlights the view that matches the panel.
    // The due values match the Due radio buttons below.
    var quickViews = new[]
    {
        (Label: "Open", Statuses: openStatusKeys, Due: "any", Count: openTasks.Count),
        (Label: "Overdue", Statuses: openStatusKeys, Due: "overdue", Count: openTasks.Count(t => t.DueDate < today)),
        (Label: "Due soon", Statuses: openStatusKeys, Due: "week", Count: openTasks.Count(t => t.DueDate >= today && t.DueDate <= weekEnd)),
        (Label: "In review", Statuses: StatusKey(TaskStatus.Review), Due: "any", Count: Model.Tasks.Count(t => t.Status == TaskStatus.Review)),
        (Label: "Done", Statuses: StatusKey(TaskStatus.Done), Due: "any", Count: Model.Tasks.Count(t => t.Status == TaskStatus.Done))
    };

    var dueOptions = new[]
    {
        (Value: "any", Label: "Any time"),
        (Value: "overdue", Label: "Overdue"),
        (Value: "today", Label: "Today"),
        (Value: "week", Label: "Next 7 days"),
        (Value: "month", Label: "Next 30 days")
    };

    // Only projects that have tasks on this page: picking any other one could never match a row.
    var projects = Model.Tasks
        .Select(t => (t.ProjectId, t.ProjectName))
        .Distinct()
        .OrderBy(p => p.ProjectName)
        .ToList();
}

<header class="page-header">
    <div>
        <h1>Tasks</h1>
        <p class="muted">
            @($"{Model.TotalTaskCount} tasks across {Model.ProjectCount} projects")
        </p>
    </div>

    <button type="button"
            class="btn btn-primary"
            onclick="document.getElementById('create-task-modal').showModal()">
        + New Task
    </button>
</header>

@* Filters run in the browser: see setUpTaskFilters in site.js and the data-task-* attributes on each row.
   Row 1: quick views (everyday shortcuts) and search. Row 2: the Filters panel, a chip for each filter
   that is on, and Group by (a view choice, not a filter, so Clear all leaves it alone). *@
<div class="stack">
    <div class="row wrap">
        <div class="pills" role="group" aria-label="Quick views">
            @foreach (var view in quickViews) {
                <button type="button"
                        data-task-view
                        data-view-statuses="@view.Statuses"
                        data-view-due="@view.Due"
                        aria-pressed="false">
                    @view.Label <span class="pill-count">@view.Count</span>
                </button>
            }
        </div>

        <div class="sp"></div>
        <input class="input input-inline"
               type="search"
               placeholder="Search tasks…"
               aria-label="Search tasks"
               data-task-search/>
    </div>

    <div class="row wrap">
        @* A <details> like the row menus (task-card-menu): it opens and closes by itself, and
           setUpClickOutsideToClose closes it on an outside click or Escape. *@
        <details class="filter-panel">
            <summary class="btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 6h16"></path>
                    <path d="M7 12h10"></path>
                    <path d="M10 18h4"></path>
                </svg>
                Filters
                @* How many filters are on (filled in by site.js). *@
                <span class="filter-count" data-filter-count hidden></span>
            </summary>

            <div class="filter-panel-body">
                <div class="filter-panel-groups">
                    @* Open statuses start ticked: that is the default view, and what "Clear all" goes back to. *@
                    <fieldset class="filter-group">
                        <legend>Status</legend>
                        <div class="filter-options">
                            @foreach (var status in statuses) {
                                <label class="filter-option">
                                    <input type="checkbox"
                                           value="@StatusKey(status)"
                                           checked="@IsOpen(status)"
                                           data-status-option/>
                                    <span>@status.GetDisplayName()</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    @* None ticked = any priority. *@
                    <fieldset class="filter-group">
                        <legend>Priority</legend>
                        <div class="filter-options">
                            @foreach (var priority in Enum.GetValues<TaskPriority>()) {
                                <label class="filter-option">
                                    <input type="checkbox" value="@priority" data-priority-option/>
                                    <span>@priority</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    @* Radio buttons: only one due range at a time. *@
                    <fieldset class="filter-group">
                        <legend>Due</legend>
                        <div class="filter-options">
                            @foreach (var due in dueOptions) {
                                <label class="filter-option">
                                    <input type="radio"
                                           name="task-due"
                                           value="@due.Value"
                                           checked="@(due.Value == "any")"
                                           data-due-option/>
                                    <span>@due.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    @* None ticked = every project. *@
                    <fieldset class="filter-group">
                        <legend>Project</legend>
                        @foreach (var project in projects) {
                            <label class="filter-check">
                                <input type="checkbox" class="checkbox" value="@project.ProjectId" data-project-option/>
                                <span>@project.ProjectName</span>
                            </label>
                        }
                    </fieldset>

                    @* GET form: ticking or unticking reloads the page with the opposite setting, because the
                       server leaves archived projects' tasks out. The hidden input carries the value to switch
                       to, because an unticked checkbox sends nothing at all. *@
                    <form asp-action="Index" method="get" class="filter-archived">
                        <input type="hidden" name="showArchived" value="@(Model.ShowArchived ? "false" : "true")"/>
                        <label class="filter-check">
                            <input type="checkbox"
                                   class="checkbox"
                                   checked="@Model.ShowArchived"
                                   onchange="this.form.submit()"/>
                            <span>Include archived projects</span>
                        </label>
                    </form>
                </div>

                <div class="filter-panel-footer">
                    <button type="button" class="btn btn-text" style="color:var(--bt)" data-clear-filters>Reset</button>
                    @* site.js writes the live count here ("Show 6 tasks"). *@
                    <button type="button" class="btn btn-primary" data-close-filters>Show tasks</button>
                </div>
            </div>
        </details>

        @* One removable chip per active filter, built by site.js. "display: contents" lets the chips
           sit in this row as if they were its own children. *@
        <div class="filter-chips" data-filter-chips></div>

        @* The archived setting lives on the server, so its chip is a plain link that reloads without it. *@
        @if (Model.ShowArchived) {
            <a class="filter-chip"
               asp-action="Index"
               asp-route-showArchived="false"
               aria-label="Remove Include archived projects filter"
               data-archived-chip>
                <span class="muted">Include:</span> archived projects
                <span class="filter-chip-remove" aria-hidden="true">×</span>
            </a>
        }

        <button type="button" class="btn btn-text" style="color:var(--bt);height:32px" data-clear-filters data-clear-all hidden>
            Clear all
        </button>

        <div class="sp"></div>

        <select class="input input-inline" aria-label="Group by" data-group-by>
            <option value="due">Group by: Due date</option>
            <option value="project">Group by: Project</option>
            <option value="priority">Group by: Priority</option>
            <option value="none">No grouping</option>
        </select>
    </div>

    @* "Showing 6 of 10 tasks", so it's always clear the filters are hiding something. *@
    <p class="muted small" role="status" data-shown-summary></p>
</div>


@{
    var groups = new[]
    {
        new
        {
            Title = "Overdue",
            Tasks = openTasks.Where(t => t.DueDate < today).ToList(),
            Color = "var(--rt)"
        },
        new
        {
            Title = "Today",
            Tasks = openTasks.Where(t => t.DueDate == today).ToList(),
            Color = "var(--at)"
        },
        new
        {
            Title = "This week",
            Tasks = openTasks.Where(t => t.DueDate > today && t.DueDate <= weekEnd).ToList(),
            Color = "var(--text)"
        },
        new
        {
            Title = "Later",
            Tasks = openTasks.Where(t => t.DueDate > weekEnd).ToList(),
            Color = "var(--text)"
        },
        new
        {
            Title = "Done",
            Tasks = Model.Tasks.Where(t => t.Status == TaskStatus.Done).ToList(),
            Color = "var(--gt)"
        },
        new
        {
            Title = "Cancelled",
            Tasks = Model.Tasks.Where(t => t.Status == TaskStatus.Cancelled).ToList(),
            Color = "var(--muted)"
        }
    };

    string DueDateLabel(DateOnly dueDate, bool isDone) =>
        isDone
            ? $"Done {dueDate.ToShortDisplay()}"
            : dueDate == today
                ? "Today"
                : dueDate.ToShortDisplay();
}

@if (Model.Tasks.Count == 0) {
    @* No tasks at all (filters never get this far: site.js shows #task-no-results for those).
       Same layout as the "Create your first project" box on Project/Index. *@
    bool hasProjects = ViewData["AvailableProjects"] is IReadOnlyList<ProjectCardViewModel> { Count: > 0 };

    <section class="card card-dashed empty-state">
        <div class="icon-tile is-lg" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3 8-8"></path>
                <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
            </svg>
        </div>

        <h2 style="font-size:20px;font-weight:700">Create your first task</h2>

        @* A task has to belong to a project, so without one, send the user to make a project first. *@
        @if (hasProjects) {
            <p class="muted">
                Tasks from all your projects show up here, grouped by when they're due.
            </p>

            <button type="button" class="btn btn-primary"
                    onclick="document.getElementById('create-task-modal').showModal()">
                + New Task
            </button>
        }
        else {
            <p class="muted">
                Tasks live inside projects. Create a project first, then add tasks to it.
            </p>

            <a asp-controller="Project" asp-action="Index" class="btn btn-primary">Go to Projects</a>
        }
    </section>
}
else {
    <div id="task-table" class="data-scroll">
        <div class="card" style="padding:0">
            <div class="data-table cols-tasks">
                <div class="data-row data-head">
                    <span></span>
                    <span>Task</span>
                    <span>Project</span>
                    <span>Priority</span>
                    <span>Due</span>
                    <span></span>
                </div>

                @foreach (var group in groups) {
                    if (group.Tasks.Count == 0) {
                        continue;
                    }

                    @* site.js rebuilds these headers for whatever "Group by" is chosen; these are the default. *@
                    <div class="group-header">
                        <span style="color:@group.Color">@group.Title</span>
                        <span class="badge badge-muted">@group.Tasks.Count</span>
                    </div>

                    @foreach (var task in group.Tasks) {
                        var isDone = task.Status == TaskStatus.Done;

                        <div class="data-row"
                             data-task-item="@StatusKey(task.Status)"
                             data-task-priority="@task.Priority"
                             data-task-text="@task.Name @task.Description"
                             data-task-due-label="@group.Title"
                             data-task-due-color="@group.Color"
                             data-task-due-order="@Array.IndexOf(groups, group)"
                             data-task-project-name="@task.ProjectName"
                             data-task-project-id="@task.ProjectId"
                             data-task-days-left="@(task.DueDate.DayNumber - today.DayNumber)"
                             data-task-priority-rank="@((int)task.Priority)"
                             data-task-date="@task.DueDate.ToString("yyyy-MM-dd")">
                            <form asp-action="ToggleCompletion"
                                  asp-route-taskId="@task.Id"
                                  method="post"
                                  class="dashboard-complete-form">
                                @* Come back to this page (filters in the query string included) instead of the project page. *@
                                <partial name="_ReturnUrlInput" />
                                <input type="checkbox"
                                       class="checkbox"
                                       checked="@isDone"
                                       aria-label="@(isDone ? $"Mark {task.Name} as to do" : $"Complete {task.Name}")"
                                       onchange="this.form.submit()"/>
                            </form>

                            <div style="min-width:0">
                                @* Struck through when done or cancelled, like the board on Project/Detail. *@
                                <div class="@(task.Status.IsFinished() ? "is-done" : "")" style="font-weight:600">
                                    @task.Name
                                </div>
                                @if (!string.IsNullOrWhiteSpace(task.Description)) {
                                    <div class="muted small"
                                         style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        @task.Description
                                    </div>
                                }
                            </div>

                            <a asp-controller="Project"
                               asp-action="Detail"
                               asp-route-projectId="@task.ProjectId"
                               style="color:var(--bt);text-decoration:none;font-weight:500">
                                @task.ProjectName
                            </a>

                            <partial name="_PriorityBadge" model="task.Priority" />

                            <span
                                style="display:flex;align-items:center;gap:6px;font-size:13px;color:@(group.Title == "Overdue" ? "var(--rt)" : "var(--muted)")">
                                <partial name="_CalendarIcon" />
                                @DueDateLabel(task.DueDate, isDone)
                            </span>

                            <details class="task-card-menu task-row-menu">
                                <summary aria-label="Task actions for @task.Name">
                                    <svg width="18" height="18" viewBox="0 0 24 24"
                                         fill="currentColor" aria-hidden="true">
                                        <circle cx="5" cy="12" r="1.5"></circle>
                                        <circle cx="12" cy="12" r="1.5"></circle>
                                        <circle cx="19" cy="12" r="1.5"></circle>
                                    </svg>
                                </summary>

                                <div class="task-card-menu-panel">
                                    @* Opens the edit modal rendered below the table (same as Project/Detail). *@
                                    <button type="button"
                                            onclick="document.getElementById('update-task-modal-@task.Id').showModal()">
                                        Edit
                                    </button>

                                    <form asp-controller="Task"
                                          asp-action="Delete"
                                          asp-route-taskId="@task.Id"
                                          method="post"
                                          data-confirm-task-trash="@task.Name"
                                          data-trash-detail="in @task.ProjectName">
                                        <partial name="_ReturnUrlInput" />
                                        <button type="submit">Move to trash</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* One edit modal per task. Kept outside the table: site.js hides filtered rows, and a dialog
       inside a hidden row couldn't be shown. *@
    @foreach (var task in Model.Tasks) {
        <partial name="_UpdateTaskModal"
                 view-data='new ViewDataDictionary(ViewData) { { "ProjectName", task.ProjectName } }'
                 model="new TaskItemUpdateViewModel
                 {
                     Id = task.Id,
                     ProjectId = task.ProjectId,
                     Name = task.Name,
                     Description = task.Description,
                     Status = task.Status,
                     Priority = task.Priority,
                     DueDate = task.DueDate
                 }"/>
    }

    @* Shown by site.js (setUpTaskFilters) when the search/filters match nothing.
       Same building blocks as the "Create your first task" box above: card-dashed + empty-state + icon-tile. *@
    <section id="task-no-results" class="card card-dashed empty-state" role="status" hidden>
        <div class="icon-tile is-lg" aria-hidden="true">
            @* A magnifying glass: "searched, found nothing" (same icon as the search box in the design). *@
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3"></path>
            </svg>
        </div>

        <h2 style="font-size:20px;font-weight:700">No tasks match your filters</h2>
        <p class="muted">Try removing a filter or searching for something else.</p>

        <div class="row wrap" style="justify-content:center;margin-top:6px">
            <button type="button" class="btn btn-lg" data-clear-filters>Clear filters</button>
        </div>
    </section>
}
<partial name="_CreateTaskModal" model="createTaskModel"/>