@model TaskMangerLE.Models.TaskListViewModel

@{
    ViewData["Title"] = "Tasks";

    var createTaskModel =
        ViewData["CreateTaskModel"] as TaskItemCreateViewModel
        ?? new TaskItemCreateViewModel();
}

<header class="page-header">
    <div>
        <h1>Tasks</h1>
        <p class="muted">
            @($"{Model.TotalTaskCount} tasks across {Model.ProjectCount} projects")
        </p>
    </div>

    <button type="button"
            class="btn btn-primary"
            onclick="document.getElementById('create-task-modal').showModal()">
        + New Task
    </button>
</header>

<div class="stack">
    <div class="row wrap">
        <div class="pills" aria-label="Task status">
            <button type="button" class="is-active">All (@Model.TotalTaskCount)</button>
            <button type="button">In Progress (@Model.Tasks.Count(t => t.Status == TaskMangerLE.Models.Enums.TaskStatus.InProgress))</button>
            <button type="button">Completed (@Model.Tasks.Count(t => t.Status == TaskMangerLE.Models.Enums.TaskStatus.Done))</button>
        </div>

        <div class="sp"></div>
        <input class="input input-inline" type="search" placeholder="Search tasks…" aria-label="Search tasks">
    </div>

    <div class="row wrap filters-row">
        <select class="input input-inline" aria-label="Project">
            <option value="">All projects</option>
            @foreach (var project in Model.Tasks.Select(t => t.ProjectName).Distinct().OrderBy(name => name)) {
                <option value="@project">@project</option>
            }
        </select>

        <select class="input" aria-label="Priority">
            <option value="">Any priority</option>
            <option>High</option>
            <option>Medium</option>
            <option>Low</option>
        </select>

        <select class="input" aria-label="Due date">
            <option value="">Any due date</option>
            <option>Overdue</option>
            <option>Today</option>
            <option>This week</option>
            <option>Later</option>
        </select>

        <select class="input" aria-label="Group by">
            <option value="">Group by: Due date</option>
            <option>Group by: Project</option>
            <option>Group by: Priority</option>
            <option>No grouping</option>
        </select>

        <div class="sp"></div>
        <a href="@Url.Action("Index", "Task")" class="btn-text" style="color: var(--bt)"> Clear filters </a>
    </div>
</div>

<partial name="_CreateTaskModal" model="createTaskModel"/>