@model TaskMangerLE.Models.TaskItem

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>@ViewData["TaskName"]</h4>
<hr/>
<div>
    <div>
        <form asp-action="Update" method="post">
            <input asp-for="Id" type="hidden"/>
            <input asp-for="ProjectId" type="hidden"/>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter Name"/>
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" placeholder="Enter Description"/>
                <span asp-validation-for="Description"></span>
            </div>

            <div>
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()" class="form-select"></select>
            </div>

            <div>
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="form-select"></select>
            </div>

            <div class="form-group">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" type="date" class="form-control">
                <span asp-validation-for="DueDate"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="Task" asp-route-projectId="@Model.ProjectId">Back to List</a>
</div>