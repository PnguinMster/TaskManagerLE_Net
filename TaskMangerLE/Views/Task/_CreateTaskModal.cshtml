@model TaskMangerLE.Models.TaskItemCreateViewModel

<dialog id="create-task-modal" class="modal"
        aria-labelledby="create-task-title">
    <div class="modal-header">
        <h2 id="create-task-title">New task</h2>
        <button type="button" class="icon-btn" style="border:0"
                aria-label="Close"
                onclick="document.getElementById('create-task-modal').close()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    @* data-create-item: sent with fetch, see submitCreateForm in site.js. *@
    <form asp-controller="Task" asp-action="Create" method="post" data-check-required data-create-item="task" novalidate>
        <div class="modal-body">
            <div class="form-group">
                <label asp-for="Name">Title</label>
                <input asp-for="Name" class="input"
                       placeholder="e.g. Draft the project brief"
                       maxlength="@ItemConstraints.NameMaxLength"
                       autocomplete="off"/>
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <div class="row" style="justify-content:space-between">
                    <label asp-for="Description">Description</label>
                    <span class="muted" style="font-size:12px">Optional</span>
                </div>
                <textarea asp-for="Description" class="input"
                          maxlength="@ItemConstraints.DescriptionMaxLength"
                          placeholder="Add details for this task"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
                <div class="form-group">
                    <label asp-for="ProjectId">Project</label>
                    <select asp-for="ProjectId" class="input">
                        @foreach (ProjectCardViewModel project in
                                      (IReadOnlyList<ProjectCardViewModel>)ViewData["AvailableProjects"]!) {
                            if (project.Id == Model.ProjectId) {
                                <option value="@project.Id" selected>@project.Name</option>
                            }
                            else {
                                <option value="@project.Id">@project.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Status"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<TaskMangerLE.Models.Enums.TaskStatus>()"
                            class="input"></select>
                    <span asp-validation-for="Status"></span>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
                <div class="form-group">
                    <label asp-for="Priority"></label>
                    <select asp-for="Priority"
                            asp-items="Html.GetEnumSelectList<TaskMangerLE.Models.Enums.TaskPriority>()"
                            class="input"></select>
                    <span asp-validation-for="Priority"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DueDate">Due date</label>
                    <input asp-for="DueDate" type="date" class="input"/>
                    <span asp-validation-for="DueDate"></span>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <span style="flex:1"></span>
            <button type="button" class="btn"
                    onclick="document.getElementById('create-task-modal').close()">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary">Create task</button>
        </div>
    </form>
</dialog>