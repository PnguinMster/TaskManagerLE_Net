@model TaskMangerLE.Models.TaskItemUpdateViewModel

<dialog id="update-task-modal-@Model.Id"
        class="modal"
        aria-labelledby="update-task-title-@Model.Id">
    <div class="modal-header">
        <h2 id="update-task-title-@Model.Id">Edit task</h2>
        <button type="button" class="icon-btn" style="border:0"
                aria-label="Close"
                onclick="document.getElementById('update-task-modal-@Model.Id').close()">
            &times;
        </button>
    </div>

    <form asp-controller="Task" asp-action="Update" method="post" data-check-required novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden"/>
        <input asp-for="ProjectId" type="hidden"/>

        <div class="modal-body">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="form-group">
                <label asp-for="Name">Title</label>
                <input asp-for="Name" class="input" autocomplete="off"/>
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <div class="row" style="justify-content:space-between">
                    <label asp-for="Description">Description</label>
                    <span class="muted" style="font-size:12px">Optional</span>
                </div>
                <textarea asp-for="Description" class="input"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
                <div class="form-group">
                    <label asp-for="ProjectId">Project</label>
                    <select asp-for="ProjectId" class="input">
                        @foreach (ProjectCardViewModel project in
                                      (IReadOnlyList<ProjectCardViewModel>)ViewData["AvailableProjects"]!) {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ProjectId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<TaskStatus>()"
                            class="input"></select>
                    <span asp-validation-for="Status" class="field-error"></span>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
                <div class="form-group">
                    <label asp-for="Priority"></label>
                    <select asp-for="Priority"
                            asp-items="Html.GetEnumSelectList<TaskPriority>()"
                            class="input"></select>
                    <span asp-validation-for="Priority" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DueDate">Due date</label>
                    <input asp-for="DueDate" type="date" class="input"/>
                    <span asp-validation-for="DueDate" class="field-error"></span>
                </div>
            </div>

            @* Passed in through ViewData (not the model) because the model is the form that gets posted back. *@
            @if (ViewData["CreatedAtUtc"] is DateTime createdAtUtc) {
                <p class="muted" style="font-size:13px;margin:0">
                    Created @createdAtUtc.ToLocalTime().ToString("MMM d, yyyy")
                </p>
            }
        </div>

        <div class="modal-footer">
            <form asp-controller="Task"
                  asp-action="Delete"
                  asp-route-taskId="@Model.Id"
                  method="post"
                  data-confirm-task-trash="@Model.Name"
                  data-trash-detail="in @ViewData["ProjectName"]">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn" style="color:var(--rt)">
                    Delete task
                </button>
            </form>

            <span style="flex:1"></span>

            <button type="button" class="btn"
                    onclick="document.getElementById('update-task-modal-@Model.Id').close()">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</dialog>