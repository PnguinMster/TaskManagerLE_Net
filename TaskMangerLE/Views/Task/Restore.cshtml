@model ProjectItem

@{
    ViewData["Title"] = "Restore";
}
<h1>@ViewData["Title"]</h1>

<h1>Restore</h1>

<table class="project-table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.DeletedAtUtc)</th>
        <th>@Html.DisplayNameFor(model => model.DeletedByUserId)</th>
        <th>Info</th>
    </tr>
    </thead>
    <tbody>
    @foreach (TaskItem task in Model.Tasks) {
        <tr>
            <td>
                @Html.DisplayFor(_ => task.Name)
            </td>
            <td>
                @Html.DisplayFor(_ => task.DeletedAtUtc)
            </td>
            <td>
                @Html.DisplayFor(_ => task.DeletedByUserId)
            </td>
            <td>
                <form asp-action="Restore" asp-controller="Task" asp-route-taskId="@task.Id" method="post"
                      onsubmit="return confirm('Restore this @task.Name?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Restore</button>
                </form>
                <form asp-action="PurgeTask" asp-controller="Task" asp-route-taskId="@task.Id" method="post"
                      onsubmit="return confirm('Permanantly Delete @task.Name? This Project will NOT be able to be restored again');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Purge</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<div>
    <a asp-action="Index" asp-controller="Task" asp-route-projectId="@Model.Id">Back to List</a>
</div>
