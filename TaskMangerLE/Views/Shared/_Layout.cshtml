
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TaskManagerLE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="navbar" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4"/></svg>
            </span>
            TaskMangerLE
        </a>

        @if (User.Identity?.IsAuthenticated == true) {
            <div class="nav-links">
                <a class="nav-link @(currentController == "Home" ? "is-active" : "")"
                   asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link @(currentController == "Project" ? "is-active" : "")"
                   asp-controller="Project" asp-action="Index">Projects</a>
                <a class="nav-link @(currentController == "Task" ? "is-active" : "")"
                   asp-controller="Task" asp-action="Index">Tasks</a>
                <a class="nav-link @(currentController == "Trash" ? "is-active" : "")"
                   asp-controller="Trash" asp-action="Index">Trash</a>
            </div>
        }

        <div class="nav-actions">
            <button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle light and dark theme">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
                </svg>
            </button>
            <partial name="_LoginPartial"/>
        </div>
    </nav>
</header>

<main class="container">
    @RenderBody()
</main>

<footer class="container row">
    <p class="muted small">&copy; @TimeProvider.GetLocalNow().Year TaskMangerLE</p>
</footer>

@* Shared confirmation popup. site.js opens it for any form with a data-confirm-trash attribute. *@
<dialog id="confirm-trash-dialog" class="modal modal-sm" role="alertdialog" aria-labelledby="confirm-trash-title">
    <div class="confirm">
        <div class="icon-tile is-rose">
            <partial name="_TrashIcon" model="24" />
        </div>
        <div class="stack" style="gap:8px">
            <h2 id="confirm-trash-title" style="font-size:20px;font-weight:700">Move project to Trash?</h2>
            <p class="muted">
                <b style="color:var(--text);font-weight:600" data-trash-name></b>
                and all of its tasks will move to the Trash. You can restore them from there at any time.
            </p>
        </div>
        <div class="summary-panel">
            <span class="muted" style="display:flex">
                <partial name="_FolderIcon" model="14" />
            </span>
            <span style="font-weight:600;flex:1;min-width:0" data-trash-name></span>
            <span class="muted" style="font-size:13px" id="confirm-trash-detail"></span>
        </div>
        <div class="actions" style="margin-top:4px">
            <button type="button" class="btn" id="confirm-trash-cancel">Cancel</button>
            <button type="button" class="btn btn-soft-danger" id="confirm-trash-ok">Move to Trash</button>
        </div>
    </div>
</dialog>

@* Same idea for tasks: opened for any form with a data-confirm-task-trash attribute. *@
<dialog id="confirm-task-trash-dialog" class="modal modal-sm" role="alertdialog" aria-labelledby="confirm-task-trash-title">
    <div class="confirm">
        <div class="icon-tile is-rose">
            <partial name="_TrashIcon" model="24" />
        </div>
        <div class="stack" style="gap:8px">
            <h2 id="confirm-task-trash-title" style="font-size:20px;font-weight:700">Move task to Trash?</h2>
            <p class="muted">
                <b style="color:var(--text);font-weight:600" data-trash-name></b>
                will move to the Trash. You can restore it from there at any time.
            </p>
        </div>
        <div class="summary-panel">
            <span class="muted" style="display:flex">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 12l3 3 5-6"></path>
                </svg>
            </span>
            <span style="font-weight:600;flex:1;min-width:0" data-trash-name></span>
            <span class="muted" style="font-size:13px" id="confirm-task-trash-detail"></span>
        </div>
        <div class="actions" style="margin-top:4px">
            <button type="button" class="btn" id="confirm-task-trash-cancel">Cancel</button>
            <button type="button" class="btn btn-soft-danger" id="confirm-task-trash-ok">Move to Trash</button>
        </div>
    </div>
</dialog>

@* Toasts stack here (bottom right). site.js adds and removes them; aria-live makes screen
   readers announce each new one. *@
<div class="toasts" id="toasts" aria-live="polite"></div>

@* The toasts (a JSON list, up to 3) a controller set before redirecting (this.ShowToast). Reading
   TempData marks them as used, so they show once. Html.Raw is safe: the serializer escapes < and >. *@
@if (TempData[TaskMangerLE.Controllers.ToastExtensions.TempDataKey] is string toastJson) {
    <script type="application/json" id="server-toasts">@Html.Raw(toastJson)</script>
    @* The toast's action button (Undo) submits this form, so the POST carries the anti-forgery token. *@
    <form id="server-toast-form" method="post" hidden>@Html.AntiForgeryToken()</form>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
