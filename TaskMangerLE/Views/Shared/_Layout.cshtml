<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TaskManagerLE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="navbar" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">T</span>
            <span>TaskMangerLE</span>
        </a>

        <div class="nav-links">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link" asp-controller="Projects" asp-action="Index">Projects</a>
            <a class="nav-link" asp-controller="Tasks" asp-action="Index">Tasks</a>
            @* <a class="nav-link" asp-controller="Trash" asp-action="Index">Tasks</a> *@
        </div>

        <div class="nav-actions">
            <button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle light and dark theme">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
                </svg>
            </button>
           
            <partial name="_LoginPartial"/>
        </div>
    </nav>
</header>

<main class="container">
    @RenderBody()
</main>

<footer class="container">
    <p class="muted small">&copy; @DateTime.Now.Year TaskMangerLE</p>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
