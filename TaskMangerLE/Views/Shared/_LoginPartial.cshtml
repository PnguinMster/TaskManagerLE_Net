@if (User.Identity?.IsAuthenticated == true) {
    <a class="nav-link" asp-controller="Account" asp-action="Index">
        @User.Identity.Name
    </a>

    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="menu-item" role="menuitem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
            </svg>
            <span class="sp">Log out</span>
        </button>
    </form>
}
else {
    <a class="btn" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
}