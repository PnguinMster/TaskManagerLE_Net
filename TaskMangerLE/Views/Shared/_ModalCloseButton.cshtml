@* The X in a modal's header. data-close-modal: site.js closes the <dialog> this button sits in
   (see setUpModalButtons), so the same markup works in every modal. *@
<button type="button" class="icon-btn borderless" aria-label="Close" data-close-modal>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"></path>
    </svg>
</button>
