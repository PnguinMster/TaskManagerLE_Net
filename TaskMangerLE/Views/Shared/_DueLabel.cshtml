@* Due date for any project or task: "Due Nov 20" (plain), "Due today" or "Overdue · Nov 5" (badges). *@
@model DueLabelViewModel

@{
    // GetDueGroup is the one overdue/today/finished rule; the filters on Projects and Tasks use it too.
    DueGroup dueGroup = Model.DueDate.GetDueGroup(TimeProvider.Today(), Model.IsFinished);
    string dueText = Model.DueDate.ToShortDisplay();
}

@* Urgent dates get a badge so they stand out; an ordinary date is plain text with a calendar icon. *@
@if (dueGroup == DueGroup.Overdue) {
    <span class="badge badge-rose">Overdue · @dueText</span>
}
else if (dueGroup == DueGroup.Today) {
    <span class="badge badge-amber">Due today</span>
}
else {
    <span class="due"><partial name="_CalendarIcon" /> Due @dueText</span>
}
