@* Check-circle icon, used for tasks. The model is the size in px: <partial name="_TaskIcon" model="14" />.
   Decorative (aria-hidden), so the text around it has to say what it means. *@
@model int
<svg width="@Model" height="@Model" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M8 12l3 3 5-6"></path>
</svg>
