@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>Manage Projects and Tasks Without the Bloat.</h1>

    <p class="muted">
        Keep your projects organized, break work into manageable tasks, restore anything you delete by mistake,
        and see what needs your attention—all in one place.
    </p>

    <div class="row wrap">
        <a class="btn btn-primary btn-lg"
           asp-controller="Account"
           asp-action="Register">
            Get Started - Register
        </a>
        <a class="btn btn-lg"
           asp-controller="Account"
           asp-action="Login">
            Log in
        </a>
    </div>
</section>

<section class="features" aria-label="What you can do">
    <article class="card">
        <div class="icon-tile" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
        </div>
        <h2>Dedicated projects</h2>
        <p class="muted">Give every project its own space with a description, due date, and live progress bar.</p>
    </article>

    <article class="card">
        <div class="icon-tile is-green" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
        </div>
        <h2>Tasks that stay organized</h2>
        <p class="muted">Break projects into clear tasks, set priorities and due dates, and keep work moving.</p>
    </article>

    <article class="card">
        <div class="icon-tile is-amber" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M3 3v18h18"/>
                <path d="m19 9-5 5-4-4-5 5"/>
            </svg>
        </div>
        <h2>Progress at a glance</h2>
        <p class="muted">See what’s complete and what still needs attention across your projects.</p>
    </article>
</section>