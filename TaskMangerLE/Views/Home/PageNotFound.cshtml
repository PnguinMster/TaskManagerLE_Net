@{
    ViewData["Title"] = "Page not found";
    var originalPath = ViewData["OriginalPath"] as string;
}

<div class="error-page">
    <div class="icon-tile is-lg">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3M9 9l4 4M13 9l-4 4"></path>
        </svg>
    </div>

    <span class="badge badge-blue">Error 404</span>

    <h1>Page not found</h1>

    <p class="muted">
        We could not find the page you were looking for. It may have been moved, or the link might be wrong.
    </p>

    @if (!string.IsNullOrEmpty(originalPath))
    {
        <div class="code-box">@originalPath</div>
    }

    <div class="row wrap" style="justify-content: center; margin-top: 8px;">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Go to Home</a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Project" asp-action="Index" class="btn btn-lg">View Projects</a>
        }
    </div>
</div>
