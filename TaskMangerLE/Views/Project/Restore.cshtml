@model IEnumerable<TaskMangerLE.Models.ProjectItem>

@{
    ViewData["Title"] = "Restore";
}
<h1>@ViewData["Title"]</h1>

<h1>Restore</h1>

<table class="project-table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.DeletedAtUtc)</th>
        <th>@Html.DisplayNameFor(model => model.DeletedByUserId)</th>
        <th>Info</th>
    </tr>
    </thead>
    <tbody>
    @foreach (ProjectItem project in Model) {
        <tr>
            <td>
                @Html.DisplayFor(_ => project.Name)
            </td>
            <td>
                @Html.DisplayFor(_ => project.DeletedAtUtc)
            </td>
            <td>
                @Html.DisplayFor(_ => project.DeletedByUserId)
            </td>
            <td>
                <form asp-action="Restore" asp-controller="Project" asp-route-projectId="@project.Id" method="post"
                      onsubmit="return confirm('Restore this @project.Name?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Restore</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>