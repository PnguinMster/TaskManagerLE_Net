@model IEnumerable<TaskMangerLE.Models.ProjectItem>

@{
    ViewData["Title"] = "Project Manager";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="">Create New</a>
</p>

<table class="project-table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.Description)</th>
        <th>@Html.DisplayNameFor(model => model.Status)</th>
        <th>Info</th>
    </tr>
    </thead>
    <tbody>
    @foreach (ProjectItem project in Model) {
        <tr>
            <td>
                @Html.DisplayFor(_ => project.Name)
            </td>
            <td>
                @Html.DisplayFor(_ => project.Description)
            </td>
            <td>
                @Html.DisplayFor(_ => project.Status)
            </td>
            <td>
                <a asp-controller="Task" asp-action="Index" asp-route-projectId="@project.Id">Details</a> |
                <a asp-action="Update" asp-controller="Project" asp-route-projectId="@project.Id">Edit</a>
                <form asp-action="Delete" asp-controller="Project" asp-route-taskId="@project.Id" method="post"
                      onsubmit="return confirm('Delete this @project.Name? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>