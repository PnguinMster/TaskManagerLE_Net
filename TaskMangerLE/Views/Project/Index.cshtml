@model IEnumerable<TaskMangerLE.Models.ProjectItem>

@{
    ViewData["Title"] = "Project Manager";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="">Create New</a>
</p>

<table class="project-table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.Description)</th>
        <th>@Html.DisplayNameFor(model => model.Status)</th>
        <th>Task Amount</th>
        <th>Info</th>
    </tr>
    </thead>
    <tbody>
    @foreach (ProjectItem project in Model) {
        <tr>
            <td>
                @Html.DisplayFor(_ => project.Name)
            </td>
            <td>
                @Html.DisplayFor(_ => project.Description)
            </td>
            <td>
                @Html.DisplayFor(_ => project.Status)
            </td>
            <td>
                @Html.DisplayFor(_ => project.Tasks.Count)
            </td>
            <td>
                <a asp-controller="Task" asp-action="Index" asp-route-id="@project.Id">Details</a> |
                <a asp-action="Update" asp-route-id="@project.Id">Edit</a> |
            </td>
        </tr>
    }
    </tbody>
</table>