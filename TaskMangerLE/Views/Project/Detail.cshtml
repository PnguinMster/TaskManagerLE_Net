@model ProjectDetailViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="project-detail-page">
    <nav aria-label="Breadcrumb">
        <a asp-action="Index">← All Projects</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">@Model.Name</span>
    </nav>

    @{
        // Detail has no coloured percentage, so the text class is discarded (_).
        var (statusLabel, badgeClass, progressClass, _) = Model.Status.GetStyle();
    }

    <section class="card"
             aria-labelledby="project-title"
             style="padding:28px;display:flex;flex-direction:column;gap:24px">

        <div class="row"
             style="justify-content:space-between;flex-wrap:wrap;align-items:flex-start;gap:20px">
            <div style="flex:1 1 420px">
                <div class="row" style="flex-wrap:wrap;align-items:center;gap:12px">
                    <h1 id="project-title"
                        style="font-size:36px;font-weight:700;line-height:1.15;margin:0">
                        @Model.Name
                    </h1>
                    <span class="badge @badgeClass">@statusLabel</span>
                </div>

                <p class="muted" style="font-size:16px;margin-top:10px;max-width:720px">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No project description."
                        : Model.Description)
                </p>
            </div>

            <div class="row" style="flex-wrap:wrap">
                <button type="button" class="btn" onclick="document.getElementById('edit-project-modal').showModal()">
                    Edit Project
                </button>

                <button type="button" class="btn btn-primary"
                        onclick="document.getElementById('create-task-modal').showModal()">
                    + Add Task
                </button>

                <form asp-action="Delete"
                      asp-route-projectId="@Model.Id"
                      method="post"
                      data-confirm-trash="@Model.Name"
                      data-trash-detail="@Model.CompletedTaskCount of @Model.TotalTaskCount tasks done">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn"
                            style="color:var(--rt)">
                        Delete Project
                    </button>
                </form>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
            <article style="background:color-mix(in srgb,var(--text) 3.5%,var(--card));border:1px solid var(--divider);border-radius:12px;padding:14px 16px">
                <p class="muted" style="font-size:12px;font-weight:600">DUE DATE</p>
                <p style="font-size:18px;font-weight:600;margin-top:2px">
                    @Model.DueDate.ToLongDisplay()
                </p>
                @* A finished project isn't "overdue", so it gets no countdown (same rule as _DueLabel). *@
                @if (Model.Status is not (ProjectStatus.Completed or ProjectStatus.Cancelled or ProjectStatus.Archived)) {
                    int daysRemaining = Model.DueDate.DayNumber - TimeProvider.Today().DayNumber;

                    <p style="margin-top:6px">
                        @if (daysRemaining > 0) {
                            <span class="badge badge-muted">@(daysRemaining == 1 ? "1 day left" : $"{daysRemaining} days left")</span>
                        }
                        else if (daysRemaining == 0) {
                            <span class="badge badge-amber">Due today</span>
                        }
                        else {
                            int daysOverdue = Math.Abs(daysRemaining);
                            <span class="badge badge-rose">@(daysOverdue == 1 ? "1 day overdue" : $"{daysOverdue} days overdue")</span>
                        }
                    </p>
                }
            </article>

            <article style="background:color-mix(in srgb,var(--text) 3.5%,var(--card));border:1px solid var(--divider);border-radius:12px;padding:14px 16px">
                <p class="muted" style="font-size:12px;font-weight:600">CREATED</p>
                <p style="font-size:18px;font-weight:600;margin-top:2px">
                    @Model.CreatedAtUtc.ToLocalTime().ToLongDisplay()
                </p>
                <p class="muted" style="font-size:13px">by @Model.OwnerName</p>
            </article>

            <article style="background:color-mix(in srgb,var(--text) 3.5%,var(--card));border:1px solid var(--divider);border-radius:12px;padding:14px 16px">
                <p class="muted" style="font-size:12px;font-weight:600">OWNER</p>
                <p style="font-size:18px;font-weight:600;margin-top:2px">@Model.OwnerName</p>
                <p class="muted" style="font-size:13px">Project lead</p>
            </article>

            <article style="background:color-mix(in srgb,var(--text) 3.5%,var(--card));border:1px solid var(--divider);border-radius:12px;padding:14px 16px">
                <p class="muted" style="font-size:12px;font-weight:600">TASKS</p>
                <p style="font-size:18px;font-weight:600;margin-top:2px">
                    @Model.CompletedTaskCount of @Model.TotalTaskCount done
                </p>
                <p class="muted" style="font-size:13px">
                    @Model.RemainingTaskCount remaining
                </p>
            </article>
        </div>

        <div>
            <div class="row"
                 style="justify-content:space-between;margin-bottom:8px">
                <span style="font-weight:600">Progress</span>
                <span class="muted">
                @Model.CompletedTaskCount/@Model.TotalTaskCount tasks
                    (@Model.ProgressPercent%)
            </span>
            </div>

            <div class="progress"
                 role="progressbar"
                 aria-label="Project progress"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@Model.ProgressPercent"
                 style="height:12px">
                <div class="progress-bar @progressClass"
                     style="width:@(Model.ProgressPercent)%;transition:width .6s ease">
                </div>
            </div>
        </div>
    </section>

    <div class="row" style="justify-content:space-between;align-items:center;margin:24px 0 12px">
        <h2 style="margin:0">Task board</h2>
        @{
            // Same rule as the progress numbers above: cancelled tasks aren't counted as tasks.
            int cancelledTotal = Model.Tasks.Count(task => task.Status == TaskStatus.Cancelled);
        }
        <span class="muted">
            @(Model.Tasks.Count - cancelledTotal) tasks@(cancelledTotal > 0 ? $" · {cancelledTotal} cancelled" : "")
        </span>
    </div>

    @{
        // Columns follow the workflow order. Cancelled tasks sit in Done (with a badge) so they
        // stay visible; they're left out of the progress numbers in ProjectService.
        var columns = new[]
        {
            (Title: "To Do", Statuses: new[] { TaskStatus.ToDo }, DotClass: ""),
            (Title: "In Progress", Statuses: new[] { TaskStatus.InProgress }, DotClass: "is-progress"),
            (Title: "Review", Statuses: new[] { TaskStatus.Review }, DotClass: "is-review"),
            (Title: "Done", Statuses: new[] { TaskStatus.Done, TaskStatus.Cancelled }, DotClass: "is-done")
        };
    }

    <div style="overflow-x:auto">
        <div class="board" style="grid-template-columns:repeat(4,minmax(250px,1fr));min-width:1064px">
            @foreach (var column in columns) {
                var columnTasks = Model.Tasks
                    .Where(task => column.Statuses.Contains(task.Status))
                    // false sorts before true, so cancelled tasks go last. OrderBy is stable,
                    // so every other task keeps its existing order.
                    .OrderBy(task => task.Status == TaskStatus.Cancelled)
                    .ToList();
                int laneCancelled = columnTasks.Count(task => task.Status == TaskStatus.Cancelled);

                <section class="lane" aria-label="@column.Title tasks">
                    <div class="lane-header">
                        <span class="lane-dot @column.DotClass" aria-hidden="true"></span>
                        <h3>@column.Title</h3>
                        <span class="badge badge-muted">@(columnTasks.Count - laneCancelled)</span>
                        @if (laneCancelled > 0) {
                            <span class="muted" style="font-size:12px">+ @laneCancelled cancelled</span>
                        }
                    </div>

                    @foreach (var task in columnTasks) {
                        <partial name="~/Views/Task/_UpdateTaskModal.cshtml"
                                 view-data='new ViewDataDictionary(ViewData) { { "ProjectName", Model.Name }, { "CreatedAtUtc", task.CreatedAtUtc } }'
                                 model="new TaskItemUpdateViewModel
                                 {
                                     Id = task.Id,
                                     ProjectId = Model.Id,
                                     Name = task.Name,
                                     Description = task.Description,
                                     Status = task.Status,
                                     Priority = task.Priority,
                                     DueDate = task.DueDate
                                 }"/>
                        bool isDueToday =
                            task.DueDate == TimeProvider.Today();

                        <article class="card task-card">
                            <div class="row" style="align-items:flex-start">
                                @{
                                    bool isDone = task.Status == TaskStatus.Done;
                                    bool isCancelled = task.Status == TaskStatus.Cancelled;
                                }

                                <form asp-controller="Task"
                                      asp-action="ToggleCompletion"
                                      asp-route-taskId="@task.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="checkbox"
                                           class="checkbox"
                                           checked="@isDone"
                                           aria-label="@(isDone ? $"Mark {task.Name} as to do" : $"Mark {task.Name} as done")"
                                           onchange="this.form.submit()"/>
                                </form>

                                <details class="task-card-menu">
                                    <summary aria-label="Task actions for @task.Name">
                                        <svg width="18" height="18" viewBox="0 0 24 24"
                                             fill="currentColor" aria-hidden="true">
                                            <circle cx="5" cy="12" r="1.5"></circle>
                                            <circle cx="12" cy="12" r="1.5"></circle>
                                            <circle cx="19" cy="12" r="1.5"></circle>
                                        </svg>
                                    </summary>

                                    <div class="task-card-menu-panel">
                                        <button type="button"
                                                onclick="document.getElementById('update-task-modal-@task.Id').showModal()">
                                            Edit
                                        </button>

                                        <form asp-controller="Task"
                                              asp-action="Delete"
                                              asp-route-taskId="@task.Id"
                                              method="post"
                                              data-confirm-task-trash="@task.Name"
                                              data-trash-detail="in @Model.Name">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Move to trash</button>
                                        </form>
                                    </div>
                                </details>

                                <a asp-controller="Task"
                                   asp-action="Update"
                                   asp-route-taskId="@task.Id"
                                   class="project-title-link @(isDone || isCancelled ? "is-done" : "")"
                                   style="flex:1;font-weight:600">
                                    @task.Name
                                </a>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(task.Description)) {
                                <p class="muted small" style="margin:4px 0 0">
                                    @task.Description
                                </p>
                            }

                            <div class="task-meta">
                                @if (isCancelled) {
                                    <span class="badge badge-muted">Cancelled</span>
                                }
                                <partial name="_PriorityBadge" model="task.Priority" />
                                <span class="due @(isDueToday ? "is-today" : "")">
                                    <partial name="_CalendarIcon" />
                                    Due @task.DueDate.ToShortDisplay()
                                </span>
                            </div>
                        </article>
                    }

                    @* data-add-task-status: site.js sets the modal's Status to this lane's status before opening it.
                       Done and Cancelled share a lane, so the first status (Done) is the one used. *@
                    <button type="button" class="btn card-dashed"
                            data-add-task-status="@((int)column.Statuses[0])">
                        + Add task
                    </button>
                </section>
            }
        </div>
    </div>

    <dialog id="edit-project-modal"
            class="modal"
            aria-labelledby="edit-project-title">
        <div class="modal-header">
            <h2 id="edit-project-title">Edit project</h2>
            <button type="button"
                    class="icon-btn"
                    style="border:0"
                    aria-label="Close"
                    onclick="document.getElementById('edit-project-modal').close()">
                <svg width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="edit-project-form" asp-action="Update" method="post" data-check-required novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id"/>

            <div class="modal-body">
                <div class="form-group">
                    <label for="edit-project-name">Name</label>
                    <input id="edit-project-name"
                           name="Name"
                           class="input"
                           value="@Model.Name"
                           maxlength="@ItemConstraints.NameMaxLength"
                           autocomplete="off"
                           data-val="true"
                           data-val-required="Project title is required."/>
                    @* Written by hand: this page's model (ProjectDetailViewModel) has no [Required], so asp-for
                       can't generate these. The text must match the [Required] message on ProjectItemViewModelBase.Name. *@
                    <span data-valmsg-for="Name" class="field-error"></span>
                </div>

                <div class="form-group">
                    <div class="row" style="justify-content:space-between">
                        <label for="edit-project-description">Description</label>
                        <span class="muted" style="font-size:12px">Optional</span>
                    </div>
                    <textarea id="edit-project-description"
                              name="Description"
                              class="input"
                              style="height:103px"
                              maxlength="@ItemConstraints.DescriptionMaxLength">@Model.Description</textarea>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
                    <div class="form-group">
                        <label asp-for="Status"></label>
                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<ProjectStatus>()"
                                class="input"></select>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DueDate">Due date</label>
                        <input asp-for="DueDate" type="date" class="input"/>
                        <span asp-validation-for="DueDate"></span>
                    </div>
                </div>

                <p class="muted" style="font-size:13px;margin:0">
                    Created @Model.CreatedAtUtc.ToLocalTime().ToLongDisplay()
                    by @Model.OwnerName
                </p>
            </div>
        </form>

        @* Footer is outside the form on purpose: forms can't be nested. Save links back via form="edit-project-form". *@
        <div class="modal-footer">
                <form asp-action="Delete"
                      asp-route-projectId="@Model.Id"
                      method="post"
                      data-confirm-trash="@Model.Name"
                      data-trash-detail="@Model.CompletedTaskCount of @Model.TotalTaskCount tasks done">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" style="color:var(--rt)">
                        Delete project
                    </button>
                </form>

                <span style="flex:1"></span>
                <button type="button" class="btn"
                        onclick="document.getElementById('edit-project-modal').close()">
                    Cancel
                </button>
                <button type="submit" form="edit-project-form" class="btn btn-primary">
                    Save changes
                </button>
        </div>
    </dialog>
    <partial name="~/Views/Task/_CreateTaskModal.cshtml"
             model="new TaskItemCreateViewModel { ProjectId = Model.Id, DueDate = TimeProvider.Today() }"/>
</div>
