@* Project due date on a card: "Due Nov 20", "Due today" or "Overdue · Nov 5". *@
@model ProjectCardViewModel

@{
    // The overdue/today/finished rule lives in ProjectCardViewModel so the filter uses the same one.
    ProjectDueGroup dueGroup = Model.GetDueGroup(TimeProvider.Today());
    string dueText = Model.DueDate.ToString("MMM d");
}

@* Same badge classes as the due dates on the home page's upcoming-tasks list. *@
@if (dueGroup == ProjectDueGroup.Overdue) {
    <span class="badge badge-rose">Overdue · @dueText</span>
}
else if (dueGroup == ProjectDueGroup.Today) {
    <span class="badge badge-amber">Due today</span>
}
else {
    <span class="badge badge-muted">Due @dueText</span>
}
