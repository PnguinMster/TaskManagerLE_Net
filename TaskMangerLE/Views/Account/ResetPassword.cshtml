@model TaskMangerLE.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="card auth-card">
    <div class="stack">
        <h1>Set a new password</h1>
        <p class="muted">Choose a new password for your account.</p>
    </div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="alert field-error"></div>

        <input asp-for="Code" type="hidden"/>
        <input asp-for="Email" type="hidden"/>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" autocomplete="new-password"
                   placeholder="Enter a new password"/>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password"
                   placeholder="Enter the new password again"/>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
            Reset password
        </button>
    </form>

    <p class="foot">
        Remembered your password?
        <a asp-action="Login" asp-controller="Account">Log in</a>
    </p>
</div>