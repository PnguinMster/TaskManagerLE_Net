@* @model TaskMangerLE.Models.ForgotPasswordViewModel *@
@{
    ViewData["Title"] = "Forgot password";
}

<div class="card" style="width: 100%; max-width: 440px; margin: 40px auto 0;">
    <div class="stack">
        <h1>Forgot your password?</h1>
        <p class="muted">Enter your email address and we’ll help you reset your password.</p>
    </div>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="stack" style="margin-top: 24px;">
        <div asp-validation-summary="ModelOnly" class="alert field-error"></div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" autocomplete="email"
                   placeholder="email@example.com"/>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
            Send reset instructions
        </button>
    </form>

    <p class="muted" style="text-align: center; border-top: 1px solid var(--divider); padding-top: 20px; margin-top: 24px;">
        Remember your password?
        <a asp-action="Login" asp-controller="Account"
           style="color: var(--bt); text-decoration: none; font-weight: 600;">
            Log in
        </a>
    </p>
</div>