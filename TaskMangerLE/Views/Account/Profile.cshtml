@model TaskMangerLE.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";

    var avatarText = string.Concat(
        Model.UserName
            .Split('@', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Split('.', ' ', '_', '-')
            .Where(part => part.Length > 0)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])) ?? []);

    if (string.IsNullOrWhiteSpace(avatarText)) {
        avatarText = "?";
    }
}

<div class="profile-page">
    <header class="page-header stack" style="align-items: flex-start;">
        <h1>Profile</h1>
        <p class="muted">Manage your account details and profile settings.</p>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage) {
        <p role="status" class="success-message">@statusMessage</p>
    }

    <div class="card stack">
        <div class="row">
            <span class="avatar avatar-lg">@avatarText</span>
            <div class="stack profile-identity">
                <h2>@Model.UserName</h2>
                <p class="muted">
                    Member since @Model.MemberSinceUtc.ToLocalTime().ToLongDisplay()
                </p>
            </div>
        </div>

        <form asp-action="Profile" method="post" class="stack">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="grid-kpi">
                <div class="field">
                    <label asp-for="NewUserName"></label>
                    <input asp-for="NewUserName" class="input" autocomplete="username"/>
                    <span asp-validation-for="NewUserName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="NewEmail"></label>
                    <input asp-for="NewEmail" class="input" autocomplete="email"/>
                    <span asp-validation-for="NewEmail" class="field-error"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" class="input" autocomplete="current-password" placeholder="Enter current password"/>
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <div class="row" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>

    <div class="card stack">
        <h2>Change password</h2>
        <p class="muted">Enter your current password, then choose a new one.</p>

        <form asp-action="ChangePassword" method="post" class="stack">

            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="field">
                <label asp-for="ChangePassword.CurrentPassword"></label>
                <input asp-for="ChangePassword.CurrentPassword" class="input" autocomplete="current-password" placeholder="Enter current password"/>
                <span asp-validation-for="ChangePassword.CurrentPassword" class="field-error"></span>
            </div>

            <div class="grid-kpi">
                <div class="field">
                    <label asp-for="ChangePassword.NewPassword"></label>
                    <input asp-for="ChangePassword.NewPassword" class="input" autocomplete="new-password" placeholder="Create a new password"/>
                    <span asp-validation-for="ChangePassword.NewPassword" class="field-error"></span>
                    <small class="muted">
                        At least 8 characters, with an uppercase letter, a lowercase letter and a number.
                    </small>
                </div>

                <div class="field">
                    <label asp-for="ChangePassword.ConfirmNewPassword"></label>
                    <input asp-for="ChangePassword.ConfirmNewPassword" class="input" autocomplete="new-password" placeholder="Enter your new password again"/>
                    <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="field-error"></span>
                </div>
            </div>

            <div class="row" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary">Update password</button>
            </div>
        </form>
    </div>
</div>