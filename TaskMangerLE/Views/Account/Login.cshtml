@model TaskMangerLE.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";

    var hasLoginError = ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]!.Errors.Count > 0;
}

<div class="card" style="width: 100%; max-width: 440px; margin: 40px auto 0; padding: 32px">
    <div style="display: flex; flex-direction: column; gap: 6px;">
        <h1 style="font-size: 26px; font-weight: 700;">Welcome back</h1>
        <p class="muted">Log in to your ProjectPulse account.</p>
    </div>

    <form asp-action="Login" asp-controller="Account" method="post"
          style="display: flex; flex-direction: column; gap: 18px; margin-top: 24px;">
        <div asp-validation-summary="ModelOnly" class="alert field-error"></div>

        <div class="field">
            <div class="row between">
                <label asp-for="UsernameOrEmail"></label>
            </div>
            <input asp-for="UsernameOrEmail" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="username"
                   placeholder="email@example.com"/>
            <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
        </div>

        <div class="field">
            <div class="row between">
                <label asp-for="Password"></label>
                <a href="#" style="color: var(--bt); text-decoration: none; font-weight: 600;">
                    Forgot password?
                </a>
            </div>
            <input asp-for="Password" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="current-password"
                   placeholder="Enter your password"/>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <label class="row" style="gap: 10px;">
            <input asp-for="RememberMe" class="checkbox"/>
            <span>Remember me</span>
        </label>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
    </form>

    <p class="muted" style="text-align: center; border-top: 1px solid var(--divider); padding-top: 20px; margin-top: 24px;">
        New to TaskManagerLE?
        <a asp-action="Register" asp-controller="Account"
           style="color: var(--bt); text-decoration: none; font-weight: 600;">
            Create an account
        </a>
    </p>
</div>