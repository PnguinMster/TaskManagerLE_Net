@model TaskMangerLE.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";

    // Errors added with the key string.Empty belong to the whole form, not one field
    // (AccountController.LoginFailed adds "Invalid username or password" this way).
    var loginError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasLoginError = loginError is not null;
}

<div class="card auth-card" style="gap:0">
    <div style="display: flex; flex-direction: column; gap: 6px;">
        <h1 style="font-size: 26px; font-weight: 700;">Welcome back</h1>
        <p class="muted">Log in to your TaskMangerLE account.</p>
    </div>

    <form asp-action="Login" asp-controller="Account" method="post" data-check-required
          style="display: flex; flex-direction: column; gap: 18px; margin-top: 24px;">
        @if (hasLoginError) {
            <div class="alert" role="alert">
                <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5M12 17h.01"></path>
                </svg>
                <span>@loginError</span>
            </div>
        }

        <div class="field">
            <div class="row between">
                <label asp-for="UsernameOrEmail"></label>
            </div>
            <input asp-for="UsernameOrEmail" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="username"
                   placeholder="email@example.com"/>
            <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
        </div>

        <div class="field">
            <div class="row between">
                <label asp-for="Password"></label>
                <a asp-action="ForgotPassword" asp-controller="Account"
                   style="color: var(--bt); text-decoration: none; font-weight: 600;">
                    Forgot password?
                </a>
            </div>
            <input asp-for="Password" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="current-password"
                   placeholder="Enter your password"/>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <label class="row" style="gap: 10px;">
            <input asp-for="RememberMe" class="checkbox"/>
            <span>Remember me</span>
        </label>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
    </form>

    <p class="muted" style="text-align: center; border-top: 1px solid var(--divider); padding-top: 20px; margin-top: 24px;">
        New to TaskManagerLE?
        <a asp-action="Register" asp-controller="Account"
           style="color: var(--bt); text-decoration: none; font-weight: 600;">
            Create an account
        </a>
    </p>
</div>