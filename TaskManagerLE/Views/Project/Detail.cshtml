@model ProjectDetailViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="project-detail-page">
    <nav aria-label="Breadcrumb">
        <a asp-action="Index">← All Projects</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">@Model.Name</span>
    </nav>

    @{
        // Detail has no coloured percentage, so the text class is discarded (_).
        var (statusLabel, badgeClass, progressClass, _) = Model.Status.GetStyle();
    }

    <section class="card detail-summary" aria-labelledby="project-title">

        <div class="row wrap between detail-header">
            <div class="detail-heading">
                <div class="row wrap">
                    <h1 id="project-title" class="detail-title">@Model.Name</h1>
                    <span class="badge @badgeClass">@statusLabel</span>
                </div>

                <p class="muted detail-description">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided"
                        : Model.Description)
                </p>
            </div>

            <div class="row wrap">
                <button type="button" class="btn" data-open-modal="update-project-modal">
                    Edit project
                </button>

                <button type="button" class="btn btn-primary" data-open-modal="create-task-modal">
                    + Add task
                </button>

                <form asp-action="Delete"
                      asp-route-projectId="@Model.Id"
                      method="post"
                      data-confirm-trash="@Model.Name"
                      data-trash-detail="@Model.CompletedTaskCount of @Model.TotalTaskCount tasks done">
                    <button type="submit" class="btn btn-outline-danger">Delete project</button>
                </form>
            </div>
        </div>

        <div class="grid-kpi">
            <article class="stat-tile">
                <p class="stat-tile-label">Due date</p>
                <p class="stat-tile-value">@Model.DueDate.ToLongDisplay()</p>
                @* A finished project isn't "overdue", so it gets no countdown (same rule as _DueLabel).
                   This is the page summary, so it counts days instead of using the short _DueLabel. *@
                @if (!Model.Status.IsFinished()) {
                    int daysRemaining = Model.DueDate.DayNumber - TimeProvider.Today().DayNumber;

                    <p class="stat-tile-countdown">
                        @if (daysRemaining > 0) {
                            <span class="badge badge-muted">@(daysRemaining == 1 ? "1 day left" : $"{daysRemaining} days left")</span>
                        }
                        else if (daysRemaining == 0) {
                            <span class="badge badge-amber">Due today</span>
                        }
                        else {
                            int daysOverdue = Math.Abs(daysRemaining);
                            <span class="badge badge-rose">@(daysOverdue == 1 ? "1 day overdue" : $"{daysOverdue} days overdue")</span>
                        }
                    </p>
                }
            </article>

            <article class="stat-tile">
                <p class="stat-tile-label">Created</p>
                <p class="stat-tile-value">@Model.CreatedAtUtc.ToLocalTime().ToLongDisplay()</p>
                <p class="muted small">by @Model.OwnerName</p>
            </article>

            <article class="stat-tile">
                <p class="stat-tile-label">Owner</p>
                <p class="stat-tile-value">@Model.OwnerName</p>
                <p class="muted small">Project lead</p>
            </article>

            <article class="stat-tile">
                <p class="stat-tile-label">Tasks</p>
                <p class="stat-tile-value">@Model.CompletedTaskCount of @Model.TotalTaskCount done</p>
                <p class="muted small">@Model.RemainingTaskCount remaining</p>
            </article>
        </div>

        <div>
            <div class="row between detail-progress-head">
                <span class="detail-progress-label">Progress</span>
                <span class="muted">
                    @Model.CompletedTaskCount/@Model.TotalTaskCount tasks (@Model.ProgressPercent%)
                </span>
            </div>

            <div class="progress progress-lg"
                 role="progressbar"
                 aria-label="Project progress"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@Model.ProgressPercent">
                @* The width is computed per project, so it's the one style that belongs inline. *@
                <div class="progress-bar @progressClass" style="width:@(Model.ProgressPercent)%"></div>
            </div>
        </div>
    </section>

    <div class="row between detail-board-head">
        <h2>Task board</h2>
        @{
            // Same rule as the progress numbers above: cancelled tasks aren't counted as tasks.
            int cancelledTotal = Model.Tasks.Count(task => task.Status == TaskStatus.Cancelled);
        }
        <span class="muted">
            @(Model.Tasks.Count - cancelledTotal) tasks@(cancelledTotal > 0 ? $" · {cancelledTotal} cancelled" : "")
        </span>
    </div>

    @{
        // Columns follow the workflow order. Cancelled tasks sit in Done (with a badge) so they
        // stay visible; they're left out of the progress numbers in ProjectService.
        // Each column is titled after its first status ([Display] label on the enum).
        var columns = new[]
        {
            (Statuses: new[] { TaskStatus.ToDo }, DotClass: ""),
            (Statuses: new[] { TaskStatus.InProgress }, DotClass: "is-progress"),
            (Statuses: new[] { TaskStatus.Review }, DotClass: "is-review"),
            (Statuses: new[] { TaskStatus.Done, TaskStatus.Cancelled }, DotClass: "is-done")
        };
    }

    <div class="data-scroll">
        <div class="board detail-board">
            @foreach (var column in columns) {
                var columnTasks = Model.Tasks
                    .Where(task => column.Statuses.Contains(task.Status))
                    // false sorts before true, so cancelled tasks go last. OrderBy is stable,
                    // so every other task keeps its existing order.
                    .OrderBy(task => task.Status == TaskStatus.Cancelled)
                    .ToList();
                int laneCancelled = columnTasks.Count(task => task.Status == TaskStatus.Cancelled);
                string columnTitle = column.Statuses[0].GetDisplayName();

                <section class="lane" aria-label="@columnTitle tasks">
                    <div class="lane-header">
                        <span class="lane-dot @column.DotClass" aria-hidden="true"></span>
                        <h3>@columnTitle</h3>
                        <span class="badge badge-muted">@(columnTasks.Count - laneCancelled)</span>
                        @if (laneCancelled > 0) {
                            <span class="muted lane-note">+ @laneCancelled cancelled</span>
                        }
                    </div>

                    @foreach (var task in columnTasks) {
                        <partial name="~/Views/Task/_UpdateTaskModal.cshtml"
                                 view-data='new ViewDataDictionary(ViewData) { { "ProjectName", Model.Name }, { "CreatedAtUtc", task.CreatedAtUtc } }'
                                 model="new TaskItemUpdateViewModel
                                 {
                                     Id = task.Id,
                                     ProjectId = Model.Id,
                                     Name = task.Name,
                                     Description = task.Description,
                                     Status = task.Status,
                                     Priority = task.Priority,
                                     DueDate = task.DueDate
                                 }"/>

                        <article class="card task-card">
                            <div class="row task-card-head">
                                @{
                                    bool isDone = task.Status == TaskStatus.Done;
                                    bool isCancelled = task.Status == TaskStatus.Cancelled;
                                }

                                <form asp-controller="Task"
                                      asp-action="ToggleCompletion"
                                      asp-route-taskId="@task.Id"
                                      method="post">

                                    <input type="checkbox"
                                           class="checkbox"
                                           checked="@isDone"
                                           aria-label="@(isDone ? $"Mark {task.Name} as to do" : $"Mark {task.Name} as done")"
                                           onchange="this.form.submit()"/>
                                </form>

                                <details class="task-card-menu">
                                    <summary aria-label="Task actions for @task.Name">
                                        <svg width="18" height="18" viewBox="0 0 24 24"
                                             fill="currentColor" aria-hidden="true">
                                            <circle cx="5" cy="12" r="1.5"></circle>
                                            <circle cx="12" cy="12" r="1.5"></circle>
                                            <circle cx="19" cy="12" r="1.5"></circle>
                                        </svg>
                                    </summary>

                                    <div class="task-card-menu-panel">
                                        <button type="button" data-open-modal="update-task-modal-@task.Id">
                                            Edit
                                        </button>

                                        <form asp-controller="Task"
                                              asp-action="Delete"
                                              asp-route-taskId="@task.Id"
                                              method="post"
                                              data-confirm-task-trash="@task.Name"
                                              data-trash-detail="in @Model.Name">
                                            <partial name="_ReturnUrlInput" />
                                            <button type="submit">Move to trash</button>
                                        </form>
                                    </div>
                                </details>

                                @* Opens the same edit modal as the menu's Edit (no separate edit page). *@
                                <button type="button"
                                        class="project-title-link task-card-title @(task.Status.IsFinished() ? "is-done" : "")"
                                        data-open-modal="update-task-modal-@task.Id">
                                    @task.Name
                                </button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(task.Description)) {
                                <p class="muted small task-card-description">
                                    @task.Description
                                </p>
                            }

                            <div class="task-meta">
                                @* Priority doesn't matter once a task is cancelled, so the Cancelled badge replaces it. *@
                                @if (isCancelled) {
                                    <span class="badge badge-muted">Cancelled</span>
                                } else {
                                    <partial name="_PriorityBadge" model="task.Priority" />
                                }
                                <partial name="_DueLabel" model="new DueLabelViewModel(task.DueDate, task.Status.IsFinished())" />
                            </div>
                        </article>
                    }

                    @* data-add-task-status: site.js sets the modal's Status to this lane's status before opening it.
                       Done and Cancelled share a lane, so the first status (Done) is the one used. *@
                    <button type="button" class="btn card-dashed"
                            data-add-task-status="@((int)column.Statuses[0])">
                        + Add task
                    </button>
                </section>
            }
        </div>
    </div>

    <partial name="_UpdateProjectModal"
             view-data='new ViewDataDictionary(ViewData)
             {
                 { "CreatedAtUtc", Model.CreatedAtUtc },
                 { "OwnerName", Model.OwnerName },
                 { "TrashDetail", $"{Model.CompletedTaskCount} of {Model.TotalTaskCount} tasks done" }
             }'
             model="new ProjectItemUpdateViewModel
             {
                 Id = Model.Id,
                 Name = Model.Name,
                 Description = Model.Description,
                 Status = Model.Status,
                 DueDate = Model.DueDate
             }"/>
    <partial name="~/Views/Task/_CreateTaskModal.cshtml"
             model="new TaskItemCreateViewModel { ProjectId = Model.Id, DueDate = TimeProvider.Today() }"/>
</div>
