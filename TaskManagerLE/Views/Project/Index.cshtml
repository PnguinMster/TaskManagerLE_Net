@model IReadOnlyList<ProjectCardViewModel>

@{
    ViewData["Title"] = "Projects";
    DateOnly today = TimeProvider.Today();

    // Same order as the "Sort by: Due date" option (the default): finished projects last, then soonest first.
    // Doing it here means the page loads already in the default order, so nothing jumps around.
    var projects = Model.OrderBy(p => p.IsFinished).ThenBy(p => p.DueDate).ThenBy(p => p.Name).ToList();

    // Every status, for the Status checkboxes in the Filters panel, in workflow order (as in the enum).
    // Listed by hand because Enum.GetValues sorts by number, and Archived is 1. Labels come from [Display].
    // The checkbox values (see StatusKey) are what each card's data-project-item holds.
    ProjectStatus[] statuses =
    [
        ProjectStatus.Planning, ProjectStatus.Active, ProjectStatus.OnHold,
        ProjectStatus.Completed, ProjectStatus.Cancelled, ProjectStatus.Archived
    ];

    // "OnHold" -> "onhold". The same rule as data-project-item below.
    string StatusKey(ProjectStatus status) => status.ToString().ToLowerInvariant();

    // "Open" = not finished (see ProjectStatusExtensions.IsFinished). These start ticked: the default view.
    bool IsOpen(ProjectStatus status) => !status.IsFinished();
    var openProjects = Model.Where(p => !p.IsFinished).ToList();
    var openStatusKeys = string.Join(",", statuses.Where(IsOpen).Select(StatusKey));

    // Quick views are presets for the Filters panel, like on the Tasks page: clicking one ticks these
    // statuses and picks this due option. The due values match the Due radio buttons below.
    var quickViews = new[]
    {
        (Label: "Open", Statuses: openStatusKeys, Due: "any", Count: openProjects.Count),
        (Label: "Overdue", Statuses: openStatusKeys, Due: "overdue",
            Count: openProjects.Count(p => p.GetDueGroup(today) == DueGroup.Overdue)),
        (Label: "Due soon", Statuses: openStatusKeys, Due: "week",
            Count: openProjects.Count(p => p.GetDueGroup(today) is DueGroup.Today or DueGroup.ThisWeek)),
        (Label: "Completed", Statuses: StatusKey(ProjectStatus.Completed), Due: "any",
            Count: Model.Count(p => p.Status == ProjectStatus.Completed)),
        (Label: "Archived", Statuses: StatusKey(ProjectStatus.Archived), Due: "any",
            Count: Model.Count(p => p.Status == ProjectStatus.Archived))
    };

    // Built on DueGroup (data-project-due), so the server and the filter agree on "overdue" etc.
    // "week" = today or the next 7 days. Finished projects never match anything but "Any time".
    var dueOptions = new[]
    {
        (Value: "any", Label: "Any time"),
        (Value: "overdue", Label: "Overdue"),
        (Value: "today", Label: "Today"),
        (Value: "week", Label: "Next 7 days"),
        (Value: "later", Label: "Later")
    };
}

<header class="page-header">
    <div>
        <h1>Projects</h1>
        <p class="muted">
            @(Model.Count == 0 ? "No projects yet" : $"{Model.Count} projects in your workspace")
        </p>
    </div>

    <div class="row">
        @if (Model.Count > 0) {
            <div class="pills" role="group" aria-label="View">
                <button id="grid-view"
                        data-view="grid"
                        class="pill-icon is-active"
                        type="button"
                        aria-label="Grid view"
                        aria-pressed="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                    </svg>
                </button>
                <button id="list-view"
                        data-view="list"
                        class="pill-icon"
                        type="button"
                        aria-label="List view"
                        aria-pressed="false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
                    </svg>
                </button>
            </div>
        }
        <button type="button" class="btn btn-primary" data-open-modal="create-project-modal">
            + New project
        </button>
    </div>
</header>

@if (Model.Count == 0) {
    <section class="card card-dashed empty-state">
        <div class="icon-tile is-lg" aria-hidden="true">
            <partial name="_FolderIcon" model="28" />
        </div>

        <h2>Create your first project</h2>

        <p class="muted">
            Projects hold your tasks and track progress for you. Start with one and add tasks as you go.
        </p>

        <button type="button" class="btn btn-primary" data-open-modal="create-project-modal">
            + New project
        </button>
    </section>
}
else {
    @* Same layout as the Tasks page (see setUpProjectFilters in site.js).
       Row 1: quick views and search. Row 2: the Filters panel, a chip per active filter, and Sort by
       (a view choice, not a filter, so Clear all leaves it alone). *@
    <div class="stack">
        <div class="row wrap">
            <div class="pills" role="group" aria-label="Quick views">
                @foreach (var view in quickViews) {
                    <button type="button"
                            data-project-view
                            data-view-statuses="@view.Statuses"
                            data-view-due="@view.Due"
                            aria-pressed="false">
                        @view.Label <span class="pill-count">@view.Count</span>
                    </button>
                }
            </div>

            <div class="sp"></div>

            <input data-project-search
                   class="input input-inline"
                   type="search"
                   placeholder="Search projects…"
                   aria-label="Search projects" />
        </div>

        <div class="row wrap">
            @* The same <details> panel and classes as the Tasks page. *@
            <details class="filter-panel">
                <summary class="btn">
                    <partial name="_FilterIcon" model="16" />
                    Filters
                    <span class="filter-count" data-filter-count hidden></span>
                </summary>

                <div class="filter-panel-body">
                    <div class="filter-panel-groups">
                        @* Open statuses start ticked: the default view, and what "Clear all" goes back to. *@
                        <fieldset class="filter-group">
                            <legend>Status</legend>
                            <div class="filter-options">
                                @foreach (var status in statuses) {
                                    <label class="filter-option">
                                        <input type="checkbox"
                                               value="@StatusKey(status)"
                                               checked="@IsOpen(status)"
                                               data-project-status-option />
                                        <span>@status.GetDisplayName()</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <fieldset class="filter-group">
                            <legend>Due</legend>
                            <div class="filter-options">
                                @foreach (var due in dueOptions) {
                                    <label class="filter-option">
                                        <input type="radio"
                                               name="project-due"
                                               value="@due.Value"
                                               checked="@(due.Value == "any")"
                                               data-project-due-option />
                                        <span>@due.Label</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    </div>

                    <div class="filter-panel-footer">
                        <button type="button" class="btn btn-text text-blue" data-project-clear-filters>Reset</button>
                        <button type="button" class="btn btn-primary" data-close-filters>Show projects</button>
                    </div>
                </div>
            </details>

            <div class="filter-chips" data-filter-chips></div>

            <button type="button" class="btn btn-text text-blue filter-clear-all" data-project-clear-filters data-clear-all hidden>
                Clear all
            </button>

            <div class="sp"></div>

            @* Reorders the cards and list rows (site.js, setUpProjectFilters). *@
            <select class="input input-inline" aria-label="Sort by" data-project-sort>
                <option value="due">Sort by: Due date</option>
                <option value="name">Sort by: Name</option>
                <option value="progress">Sort by: Progress</option>
            </select>
        </div>

        <p class="muted small" role="status" data-shown-summary></p>
    </div>

    <div id="project-grid" class="grid-cards">
        @foreach (var project in projects) {
            // The progress colours come from _ProgressBar, so only the badge parts are needed here.
            var (statusLabel, badgeClass, _, _) = project.Status.GetStyle();
            var progress = new ProgressBarViewModel(project.CompletedTaskCount, project.TotalTaskCount,
                project.ProgressPercent, project.Status, project.Name);

            <div class="card card-outline project-card"
                 data-project-item="@StatusKey(project.Status)"
                 data-project-due="@project.GetDueGroup(today).ToString().ToLowerInvariant()"
                 data-project-text="@project.Name @project.Description"
                 data-project-name="@project.Name"
                 data-project-date="@project.DueDate.ToString("yyyy-MM-dd")"
                 data-project-progress="@project.ProgressPercent">

                <div class="row between top">
                    <h3>@project.Name</h3>
                    <span class="badge @badgeClass">@statusLabel</span>
                </div>

                <p class="muted">
                    @(string.IsNullOrWhiteSpace(project.Description)
                        ? "No description provided"
                        : project.Description)
                </p>

                <div>
                    <partial name="_ProgressBar" model="progress" />
                </div>

                @* project-card-footer has margin-top: auto, so the footer sits at the bottom of every card in a row. *@
                <div class="row project-card-footer">
                    <span class="muted small sp">
                        <partial name="_DueLabel" model="new DueLabelViewModel(project.DueDate, project.IsFinished)" />
                    </span>
                    <a asp-controller="Project"
                       asp-action="Detail"
                       asp-route-projectId="@project.Id"
                       class="btn">Details</a>

                    <form asp-controller="Project"
                          asp-action="Delete"
                          asp-route-projectId="@project.Id"
                          method="post"
                          data-confirm-trash="@project.Name"
                          data-trash-detail="@project.CompletedTaskCount of @project.TotalTaskCount tasks done">
                        <partial name="_ReturnUrlInput" />
                        <button type="submit"
                                class="icon-btn"
                                aria-label="Move @project.Name to Trash">
                            <partial name="_TrashIcon" model="18" />
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div id="project-list" class="card card-flush" hidden>
        <div class="data-scroll">
            <div class="data-table cols-projects">
                <div class="data-row data-head">
                    <span>Project</span>
                    <span>Status</span>
                    <span>Progress</span>
                    <span>Next due</span>
                    <span></span>
                </div>

                @foreach (var project in projects) {
                    var (statusLabel, badgeClass, _, _) = project.Status.GetStyle();
                    var progress = new ProgressBarViewModel(project.CompletedTaskCount, project.TotalTaskCount,
                        project.ProgressPercent, project.Status, project.Name);

                    <div class="data-row"
                         data-project-item="@StatusKey(project.Status)"
                         data-project-due="@project.GetDueGroup(today).ToString().ToLowerInvariant()"
                         data-project-text="@project.Name @project.Description"
                         data-project-name="@project.Name"
                         data-project-date="@project.DueDate.ToString("yyyy-MM-dd")"
                         data-project-progress="@project.ProgressPercent">
                        @* cell-main (min-width: 0) lets long names and descriptions shrink and truncate instead of
                           stretching the column. *@
                        <span class="stack cell-main">
                            <span class="cell-title truncate">
                                <a asp-controller="Project"
                                   asp-action="Detail"
                                   asp-route-projectId="@project.Id"
                                   class="project-title-link">@project.Name</a>
                            </span>
                            <span class="muted small truncate">
                                @(string.IsNullOrWhiteSpace(project.Description)
                                    ? "No description provided"
                                    : project.Description)
                            </span>
                        </span>

                        @* A direct child of .data-row, so the ".data-row > .badge" rule keeps it at its own width. *@
                        <span class="badge @badgeClass">@statusLabel</span>

                        <div>
                            <partial name="_ProgressBar" model="progress" />
                        </div>

                        <span class="muted small">
                            <partial name="_DueLabel" model="new DueLabelViewModel(project.DueDate, project.IsFinished)" />
                        </span>

                        <div class="project-actions">
                            <a asp-controller="Project"
                               asp-action="Detail"
                               asp-route-projectId="@project.Id"
                               class="btn">Details</a>

                            <form asp-controller="Project"
                                  asp-action="Delete"
                                  asp-route-projectId="@project.Id"
                                  method="post"
                                  data-confirm-trash="@project.Name"
                                  data-trash-detail="@project.CompletedTaskCount of @project.TotalTaskCount tasks done">
                                <partial name="_ReturnUrlInput" />
                                <button type="submit"
                                        class="icon-btn"
                                        aria-label="Move @project.Name to Trash">
                                    <partial name="_TrashIcon" model="18" />
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Shown by site.js (setUpProjectFilters) when the search/filters match nothing. *@
    var noResults = new NoResultsViewModel
    {
        Id = "project-no-results",
        Title = "No projects match your filters",
        Message = "Try removing a filter or searching for something else.",
        ClearButtonAttribute = "data-project-clear-filters"
    };
    <partial name="_NoResults" model="noResults" />

    @* Applies the saved grid/list choice before the first paint. site.js loads after this, at the end of <body>,
       which could briefly show the default (grid) first. Grid is already the
       default markup, so only "list" needs work. Keep the "projectView" key in sync with site.js. *@
    <script>
        (function () {
            try {
                if (localStorage.getItem("projectView") !== "list") return;
            } catch {
                return; // storage blocked: stay on the default view
            }

            document.getElementById("project-grid").hidden = true;
            document.getElementById("project-list").hidden = false;

            const gridButton = document.getElementById("grid-view");
            const listButton = document.getElementById("list-view");
            gridButton.classList.remove("is-active");
            listButton.classList.add("is-active");
            gridButton.setAttribute("aria-pressed", "false");
            listButton.setAttribute("aria-pressed", "true");
        })();
    </script>
}

@* Outside the @if so the empty-state "+ New project" button can open it too (same as Task/Index).
   site.js finds it by id, so its place on the page doesn't matter. *@
<partial name="_CreateProjectModal" model="new ProjectItemCreateViewModel { DueDate = today }" />

