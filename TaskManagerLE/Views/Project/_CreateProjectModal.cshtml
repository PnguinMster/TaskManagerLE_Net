@model ProjectItemCreateViewModel

@* Same layout as _UpdateProjectModal, so the two stay easy to compare. Label text comes from [Display]
   on the view model (Name shows as "Title", DueDate as "Due date"). *@
<dialog id="create-project-modal" class="modal"
        aria-labelledby="create-project-title">
    <div class="modal-header">
        <h2 id="create-project-title">New project</h2>
        <partial name="_ModalCloseButton" />
    </div>

    @* data-fetch-form: sent with fetch, see submitModalForm in site.js. data-create-form: its due date
       gets the browser's today. *@
    <form id="create-project-form" asp-controller="Project" asp-action="Create" method="post" data-check-required novalidate
          data-fetch-form data-create-form data-not-saved="The project wasn't created.">

        <div class="modal-body">
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="input"
                       placeholder="e.g. Website Redesign"
                       maxlength="@ItemConstraints.NameMaxLength"
                       autocomplete="off" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="field">
                <div class="row between">
                    <label asp-for="Description"></label>
                    <span class="field-hint">Optional</span>
                </div>
                <textarea asp-for="Description" class="input"
                          placeholder="What is this project about?"
                          maxlength="@ItemConstraints.DescriptionMaxLength"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label asp-for="Status"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<ProjectStatus>()"
                            class="input"></select>
                    <span asp-validation-for="Status" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="DueDate"></label>
                    <input asp-for="DueDate" type="date" class="input" />
                    <span asp-validation-for="DueDate" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <span class="sp"></span>
            <button type="button" class="btn" data-close-modal>Cancel</button>
            <button type="submit" class="btn btn-primary">Create project</button>
        </div>
    </form>
</dialog>
