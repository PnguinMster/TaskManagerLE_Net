@using System.Security.Claims

@{
    var userName = User.Identity?.Name ?? "";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var initials = userName.ToInitials();
}

@if (User.Identity?.IsAuthenticated == true) {
    <details class="user-menu">
        <summary class="user-menu-trigger" aria-label="Open account menu">
            <span class="avatar" aria-hidden="true">@initials</span>
            <span class="user-menu-trigger-name">@userName</span>
            <svg class="user-menu-chevron" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </summary>

        <div class="user-menu-panel">
            <div class="user-menu-header">
                <span class="avatar avatar-md" aria-hidden="true">@initials</span>
                <span class="user-menu-identity">
                    <span class="user-menu-name">@userName</span>
                    <span class="user-menu-email">@email</span>
                </span>
            </div>

            <div class="user-menu-divider" role="separator"></div>

            <a class="user-menu-item user-menu-profile"
               asp-controller="Account"
               asp-action="Profile">
                <svg class="user-menu-item-icon" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M5 21a7 7 0 0 1 14 0"/>
                </svg>
                <span>Profile</span>
            </a>

            @* <div class="user-menu-divider" role="separator"></div> *@

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="user-menu-item" type="submit">
                    <svg class="user-menu-item-icon" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <path d="M16 17l5-5-5-5"/>
                        <path d="M21 12H9"/>
                    </svg>
                    <span>Log out</span>
                </button>
            </form>
        </div>
    </details>
}
else {
    <a class="btn" asp-controller="Account" asp-action="Login">Log in</a>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
}
