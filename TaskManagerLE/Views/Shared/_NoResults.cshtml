@* "Nothing matches your filters" box. Starts hidden; site.js shows it when the search/filters
   hide every item, and the button clears them. *@
@model NoResultsViewModel

<section id="@Model.Id" class="card card-dashed empty-state" role="status" hidden>
    <div class="icon-tile is-lg" aria-hidden="true">
        @* A magnifying glass: "searched, found nothing" (same icon as the search box in the design). *@
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3"></path>
        </svg>
    </div>

    <h2>@Model.Title</h2>
    <p class="muted">@Model.Message</p>

    <div class="row wrap center">
        <button type="button" class="btn btn-lg" @Model.ClearButtonAttribute>Clear filters</button>
    </div>
</section>
