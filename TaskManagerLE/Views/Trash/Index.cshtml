@model TrashSummaryViewModel

@{
    ViewData["Title"] = "Trash";
}

<header class="page-header">
    <div>
        <h1>Trash</h1>
        <p class="muted">Deleted projects and tasks you can still restore</p>
    </div>

    <div class="row">
        @* The form tag helper adds the anti-forgery token. No confirm dialog: restoring loses nothing. *@
        <form asp-controller="Trash" asp-action="RestoreAll" method="post">
            <button type="submit" class="btn btn-success">Restore all</button>
        </form>
        <button type="button" class="btn btn-danger" id="empty-trash-open"
                data-projects="@Model.ProjectCount" data-tasks="@Model.TaskCount">Empty Trash</button>
    </div>
</header>

@* Same stat cards as the dashboard (Home/Index). *@
<section class="grid-kpi" aria-label="Trash summary">
    <article class="card">
        <p class="kpi-label">Deleted projects</p>
        <p class="kpi-value text-blue">@Model.ProjectCount</p>
    </article>

    <article class="card">
        <p class="kpi-label">Deleted tasks</p>
        <p class="kpi-value text-purple">@Model.TaskCount</p>
    </article>

    <article class="card">
        <p class="kpi-label">Total in Trash</p>
        <p class="kpi-value">@Model.TotalCount</p>
    </article>
</section>

@* "Empty Trash" confirmation. Same markup and classes as _ConfirmDialog, so the two look the same,
   but written out here because it needs a checkbox and a real form (the browser posts it, no site.js
   submit). The button stays disabled until the checkbox is ticked (see setUpEmptyTrashDialog in site.js). *@
<dialog id="empty-trash-dialog" class="modal modal-sm" role="alertdialog" aria-labelledby="empty-trash-title">
    @* The form tag helper adds the anti-forgery token for us. *@
    <form asp-controller="Trash" asp-action="EmptyTrash" method="post" class="confirm">
        <div class="icon-tile is-rose">
            <partial name="_WarningIcon" model="24" />
        </div>
        <div class="stack tight">
            <h2 id="empty-trash-title" class="confirm-title">Empty Trash permanently?</h2>
            <p class="muted">
                This permanently deletes everything in the Trash. These items cannot be restored afterwards.
            </p>
        </div>
        <div class="summary-panel">
            <span class="muted summary-icon">
                <partial name="_TrashIcon" model="14" />
            </span>
            <span class="summary-name">Items in Trash</span>
            <span class="muted summary-detail" id="empty-trash-detail"></span>
        </div>
        <label class="filter-check">
            <input type="checkbox" class="checkbox" id="empty-trash-check" name="confirmed" value="true" />
            <span>I understand this cannot be undone</span>
        </label>
        <div class="actions">
            <button type="button" class="btn" id="empty-trash-cancel">Cancel</button>
            <button type="submit" class="btn btn-danger" id="empty-trash-ok" disabled>Empty Trash</button>
        </div>
    </form>
</dialog>

@* "Delete forever" confirmation for a single item. site.js opens it for any form with a
   data-confirm-purge attribute (name) and data-trash-detail (the "Deleted ..." text). *@
@{
    // Built here, not inside model="...", because the double quotes would end the attribute.
    var purgeDialog = new ConfirmDialogViewModel
    {
        IdPrefix = "confirm-purge",
        Title = "Delete forever?",
        Message = "will be permanently deleted. This cannot be undone.",
        ConfirmLabel = "Delete forever",
        ConfirmButtonClass = "btn-danger",
        SummaryIconPartial = "_FolderIcon"
    };
}
<partial name="_ConfirmDialog" model="purgeDialog" />

@{
    // Restore and Delete forever send the user back to the Trash page itself. Other forms use
    // _ReturnUrlInput (the current URL), but here the returnUrl rides along with the id in
    // asp-all-route-data, and the clean Trash URL is enough: the filters run in the browser, so
    // there is no query string worth keeping.
    var trashUrl = Url.Action("Index", "Trash") ?? "/Trash";
}

@if (Model.Items.Count == 0) {
    <section class="card card-dashed empty-state">
        <div class="icon-tile is-lg is-green" aria-hidden="true">
            <partial name="_TrashIcon" model="28" />
        </div>

        <h2>Trash is empty</h2>

        <p class="muted">
            Deleted projects and tasks will show up here so you can restore them.
        </p>
    </section>
}
else {
    // Counted from the rows below, not Model.TaskCount: that also counts tasks hidden inside a
    // deleted project, which have no row of their own (they come back with the project).
    int projectRows = Model.Items.Count(item => item.IsProject);
    int taskRows = Model.Items.Count - projectRows;

    @* Same layout as the Tasks and Projects pages: the filter row, then a "Showing X of Y" line.
       The page container's gap spaces it from the table, as on the Projects page. *@
    <div class="stack">
        <div class="row wrap">
            @* The counts start as the server's totals; site.js updates them as you search. *@
            <div class="pills" role="group" aria-label="Filter Trash items">
                <button type="button"
                        class="is-active"
                        data-trash-filter="all"
                        aria-pressed="true">
                    All items <span class="pill-count">@Model.Items.Count</span>
                </button>
                <button type="button"
                        data-trash-filter="project"
                        aria-pressed="false">
                    Projects <span class="pill-count">@projectRows</span>
                </button>
                <button type="button"
                        data-trash-filter="task"
                        aria-pressed="false">
                    Tasks <span class="pill-count">@taskRows</span>
                </button>
            </div>

            <div class="sp"></div>

            <input class="input input-inline"
                   type="search"
                   placeholder="Search Trash…"
                   aria-label="Search Trash"
                   data-trash-search />

            @* Reorders the rows in the browser (site.js). Same look as "Sort by" on the Projects page. *@
            <select class="input input-inline" aria-label="Sort by" data-trash-sort>
                <option value="newest">Sort by: Newest deleted</option>
                <option value="oldest">Sort by: Oldest deleted</option>
                <option value="name">Sort by: Name</option>
            </select>
        </div>

        @* Filled in by site.js, so it's always clear when the filters are hiding something. *@
        <p class="muted small" role="status" data-trash-summary></p>
    </div>

    @* Card outside, scroller inside: card-flush has overflow:hidden, so it would clip a wider scroller. *@
    <div class="card card-flush" id="trash-table">
        <div class="data-scroll">
            <div class="data-table cols-trash">
                <div class="data-row data-head">
                    <span>Type</span>
                    <span>Item</span>
                    <span>Deleted</span>
                    <span></span>
                </div>

                @foreach (TrashItemViewModel item in Model.Items) {
                    // Stored in UTC; shown in the server's local time.
                    DateTime? deletedAt = item.DeletedAtUtc?.ToLocalTime();
                    string controller = item.IsProject ? "Project" : "Task";
                    // The two controllers name their id parameter differently (projectId / taskId).
                    var routeValues = new Dictionary<string, string>
                    {
                        [item.IsProject ? "projectId" : "taskId"] = item.Id.ToString(),
                        ["returnUrl"] = trashUrl
                    };

                    @* data-trash-name / -date are what "Sort by" orders on. The "o" (ISO 8601) format
                       sorts correctly as plain text and doesn't depend on the server's culture. *@
                    <div class="data-row" data-trash-item="@(item.IsProject ? "project" : "task")"
                         data-trash-name="@item.Name"
                         data-trash-date="@(item.DeletedAtUtc?.ToString("o") ?? "")">
                        @if (item.IsProject) {
                            <span class="badge badge-blue badge-icon">
                                <partial name="_FolderIcon" model="14" />
                                Project
                            </span>
                        }
                        else {
                            <span class="badge badge-purple badge-icon">
                                <partial name="_TaskIcon" model="14" />
                                Task
                            </span>
                        }

                        <div class="cell-main">
                            <div class="cell-title">@item.Name</div>
                            <div class="muted small">
                                @if (item.IsProject) {
                                    @(item.TaskCount == 1 ? "1 task inside" : $"{item.TaskCount} tasks inside")
                                }
                                else {
                                    @:in
                                    <a asp-controller="Project" asp-action="Detail" asp-route-projectId="@item.ProjectId"
                                      >@item.ProjectName</a>
                                }
                            </div>
                        </div>

                        <span class="muted small">@deletedAt?.ToDateTimeDisplay()</span>

                        <div class="row end">
                            @* The form tag helper adds the anti-forgery token to both forms. *@
                            <form method="post" asp-controller="@controller" asp-action="Restore"
                                  asp-all-route-data="routeValues">
                                <button type="submit" class="btn btn-outline-success">↶ Restore</button>
                            </form>
                            <form method="post" asp-controller="@controller" asp-action="Purge"
                                  asp-all-route-data="routeValues"
                                  data-confirm-purge="@item.Name"
                                  data-trash-detail="@(deletedAt is { } d ? $"Deleted {d.ToShortDisplay()}" : "")">
                                <button type="submit" class="btn btn-outline-danger">Delete forever</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Shown by site.js when the type pills and search hide every row. *@
    var noResults = new NoResultsViewModel
    {
        Id = "trash-no-results",
        Title = "No items match your filters",
        Message = "Try another type or searching for something else.",
        ClearButtonAttribute = "data-trash-clear-filters"
    };
    <partial name="_NoResults" model="noResults" />
}
