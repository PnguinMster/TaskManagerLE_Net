@model TaskManagerLE.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
}

<div class="card auth-card" style="gap: 0">
    <div class="stack">
        <h1>Set a new password</h1>
        <p class="muted">Choose a new password for your account.</p>
    </div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post"
          class="stack" style="margin-top: 24px;" data-check-required novalidate>
        <partial name="_FormErrors" />

        <input asp-for="Code" type="hidden"/>
        <input asp-for="Email" type="hidden"/>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" autocomplete="new-password"
                   placeholder="Enter a new password"/>
            <span asp-validation-for="Password" class="field-error"></span>
            <small class="muted">
                At least 8 characters, with an uppercase letter, a lowercase letter and a number.
            </small>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password"
                   placeholder="Enter the new password again"/>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
            Reset password
        </button>
    </form>

    <p class="muted" style="text-align: center; border-top: 1px solid var(--divider); padding-top: 20px; margin-top: 24px;">
        Remembered your password?
        <a asp-action="Login" asp-controller="Account"
           class="link-strong">
            Log in
        </a>
    </p>
</div>
