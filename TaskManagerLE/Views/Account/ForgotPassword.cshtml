@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="card auth-card">
    <div class="stack">
        <h1>Forgot your password?</h1>
        <p class="muted">Enter your email address and we’ll help you reset your password.</p>
    </div>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" data-check-required novalidate>
        <partial name="_FormErrors" />

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" autocomplete="email"
                   placeholder="email@example.com" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
    </form>

    <p class="foot">
        Remember your password?
        <a asp-controller="Account" asp-action="Login"
           class="link-strong">
            Log in
        </a>
    </p>
</div>
