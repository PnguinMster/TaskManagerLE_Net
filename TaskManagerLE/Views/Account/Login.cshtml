@model LoginViewModel
@{
    ViewData["Title"] = "Log in";

    // A failed login is a form-level error (key string.Empty, shown by _FormErrors). It's about both
    // fields together, so both get the red border.
    var hasLoginError = ViewData.ModelState[string.Empty]?.Errors.Count > 0;
}

<div class="card auth-card">
    <div class="stack">
        <h1>Welcome back</h1>
        <p class="muted">Log in to your TaskManagerLE account.</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" data-check-required novalidate>
        <partial name="_FormErrors" />

        <div class="field">
            <label asp-for="UsernameOrEmail"></label>
            <input asp-for="UsernameOrEmail" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="username"
                   placeholder="email@example.com" />
            <span asp-validation-for="UsernameOrEmail" class="field-error"></span>
        </div>

        <div class="field">
            <div class="row between">
                <label asp-for="Password"></label>
                <a asp-controller="Account" asp-action="ForgotPassword"
                   class="link-strong">
                    Forgot password?
                </a>
            </div>
            <input asp-for="Password" class="input @(hasLoginError ? "input-validation-error" : "")" autocomplete="current-password"
                   placeholder="Enter your password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        @* Same checkbox row as the Tasks page Filters panel. *@
        <label class="filter-check">
            <input asp-for="RememberMe" class="checkbox" />
            <span>Remember me</span>
        </label>

        <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
    </form>

    <p class="foot">
        New to TaskManagerLE?
        <a asp-controller="Account" asp-action="Register"
           class="link-strong">
            Create an account
        </a>
    </p>
</div>
